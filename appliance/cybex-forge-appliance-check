#!/usr/bin/env bash
set -Eeuo pipefail

quiet=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --quiet) quiet=1 ;;
    --skip-managed-sync) ;;
    -h|--help)
      printf 'Usage: cybex-forge-check [--quiet] [--skip-managed-sync]\n'
      exit 0
      ;;
    *) printf 'unknown option: %s\n' "$1" >&2; exit 2 ;;
  esac
  shift
done

failures=0
check() {
  local label="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    [ "$quiet" -eq 1 ] || printf 'ok: %s\n' "$label"
  else
    printf 'failed: %s\n' "$label" >&2
    failures=$((failures + 1))
  fi
}

protected_file() {
  local path="$1" mode="$2"
  [ ! -L "$path" ] && [ -f "$path" ] \
    && [ "$(stat -c '%u:%a:%h' -- "$path")" = "0:$mode:1" ]
}

config_secret_boundary() {
  local config=/etc/cybex-forge/config.toml
  ! grep -Eq '^[[:space:]]*forge_install_code[[:space:]]*=' "$config" \
    && { ! grep -Eq '^[[:space:]]*forge_install_code_file[[:space:]]*=' "$config" \
      || grep -Fx 'forge_install_code_file = "/var/lib/cybex-forge/bootstrap/enrollment-code"' "$config" >/dev/null; }
}

nixos_unit() {
  local unit="$1" resolved
  resolved="$(readlink -f -- "/etc/systemd/system/$unit")"
  case "$resolved" in /nix/store/*) return 0 ;; *) return 1 ;; esac
}

machine_identity_matches() {
  protected_file /var/lib/cybex-forge/appliance/machine-id 600 \
    && grep -Eq '^[0-9a-f]{32}$' /var/lib/cybex-forge/appliance/machine-id \
    && cmp -s /etc/machine-id /var/lib/cybex-forge/appliance/machine-id
}

media_sequence_valid() {
  local path=/var/lib/cybex-forge/appliance/media-sequence
  protected_file "$path" 600 \
    && [ "$(stat -c %s -- "$path")" -le 20 ] \
    && grep -Eq '^(0|[1-9][0-9]{0,18})$' "$path" \
    && [ "$(<"$path")" -le 9223372036854775807 ]
}

host_key_pair_matches() {
  local private=/var/lib/cybex-forge/appliance/ssh/ssh_host_ed25519_key
  local public="$private.pub" derived stored
  protected_file "$private" 600 \
    && [ ! -L "$public" ] && [ -f "$public" ] \
    && [ "$(stat -c '%u:%a:%h' -- "$public")" = 0:644:1 ] \
    || return 1
  derived="$(ssh-keygen -y -f "$private")"
  stored="$(awk 'NF >= 2 { print $1 " " $2; exit }' "$public")"
  [ "ssh-ed25519 $derived" = "$stored" ]
}

check 'Forge service active' systemctl is-active --quiet cybex-forge.service
check 'nginx service active' systemctl is-active --quiet nginx.service
check 'TFTP service active' systemctl is-active --quiet tftpd-hpa.service
check 'Nix daemon socket active' systemctl is-active --quiet nix-daemon.socket
check 'Forge unit remains NixOS-declarative' nixos_unit cybex-forge.service
check 'nginx unit remains NixOS-declarative' nixos_unit nginx.service
check 'TFTP unit remains NixOS-declarative' nixos_unit tftpd-hpa.service
check 'Forge binary identity' /usr/local/bin/cybex-forge --version
check 'active config protected' protected_file /etc/cybex-forge/config.toml 640
check 'active config contains no inline enrollment secret' config_secret_boundary
check 'appliance install identity protected' protected_file /var/lib/cybex-forge/appliance/install-state.json 600
check 'recovery config protected' protected_file /var/lib/cybex-forge/appliance/config.toml 600
check 'machine identity preserved' machine_identity_matches
check 'media recovery sequence protected' media_sequence_valid
check 'SSH host keypair preserved' host_key_pair_matches
check 'pinned iPXE source present' test -f /usr/local/src/ipxe/.cybex-forge-pinned-source
check 'local Forge health' curl -fsS --connect-timeout 2 --max-time 5 http://127.0.0.1:8080/healthz
check 'proxied PXE health' curl -fsS --connect-timeout 2 --max-time 5 'http://127.0.0.1/boot.ipxe?cybex_check=1'
check 'embedded iPXE loader present' test -s /srv/cybex-forge/tftp/snponly.efi

if [ "$failures" -ne 0 ]; then
  printf 'Cybex Forge appliance check failed: %s check(s)\n' "$failures" >&2
  exit 1
fi
[ "$quiet" -eq 1 ] || printf 'Cybex Forge appliance check passed.\n'
