#!/usr/bin/env bash
set -Eeuo pipefail

SEED_LABEL="CYBEX_FORGE_SEED"
SEED_MOUNT="/run/cybex-forge-seed"

die() {
  printf 'CYBEX_FORGE_INSTALLER stage=seed status=failure error=%s\n' "$1" >&2
  exit 1
}

validate_seed_file() {
  local path="$1" secret="$2" metadata owner mode links size
  if [ -L "$path" ] || [ ! -f "$path" ]; then die "invalid-seed-file"; fi
  metadata="$(stat -c '%u:%a:%h:%s' "$path")"
  owner="${metadata%%:*}"; metadata="${metadata#*:}"
  mode="${metadata%%:*}"; metadata="${metadata#*:}"
  links="${metadata%%:*}"; size="${metadata##*:}"
  if [ "$owner" != "0" ] || [ "$links" != "1" ]; then die "unsafe-seed-file-ownership"; fi
  [ "$size" -le 16384 ] || die "oversized-seed-file"
  if [ "$secret" = "yes" ]; then
    case "$mode" in 400|600) ;; *) die "unsafe-enrollment-code-mode" ;; esac
    [ "$size" -le 512 ] || die "oversized-enrollment-code"
  else
    case "$mode" in 400|440|444|600|640|644) ;; *) die "unsafe-answers-mode" ;; esac
  fi
}

mapfile -t seed_devices < <(blkid -t "LABEL=$SEED_LABEL" -o device 2>/dev/null || true)
if [ "${#seed_devices[@]}" -eq 0 ]; then
  printf 'CYBEX_FORGE_INSTALLER stage=ready status=interactive command=cybex-forge-appliance-install\n'
  exit 0
fi
[ "${#seed_devices[@]}" -eq 1 ] || die "ambiguous-seed-label"

install -d -m 0700 "$SEED_MOUNT"
mount -o ro,nosuid,nodev,noexec "${seed_devices[0]}" "$SEED_MOUNT"
trap 'umount "$SEED_MOUNT" >/dev/null 2>&1 || true' EXIT
validate_seed_file "$SEED_MOUNT/answers" no

args=(--answers-file "$SEED_MOUNT/answers" --yes --poweroff)
if [ -e "$SEED_MOUNT/enrollment-code" ]; then
  validate_seed_file "$SEED_MOUNT/enrollment-code" yes
  args+=(--enrollment-code-file "$SEED_MOUNT/enrollment-code" --retain-enrollment-code-source)
fi

printf 'CYBEX_FORGE_INSTALLER stage=seed status=accepted device=%s\n' "${seed_devices[0]}"
exec cybex-forge-appliance-install "${args[@]}"
