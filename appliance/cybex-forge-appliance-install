embedded_forge_binary() {
  local package_path
  package_path="$(tr -d '\n' < /etc/cybex-forge-appliance/package-path)"
  [ -x "$package_path/bin/cybex-forge" ] \
    || die "installer media has no executable embedded Forge package"
  printf '%s\n' "$package_path/bin/cybex-forge"
}

validate_config_file() {
  local config_path="$1" scope="$2" validator
  validator="$(embedded_forge_binary)"
  marker config-validation running "scope=$scope"
  "$validator" --config "$config_path" validate-appliance-config \
    >/dev/null 2>/dev/null
}

remove_config_validation_candidate() {
  [ -n "$config_validation_candidate" ] || return 0
  case "$config_validation_candidate" in
    /run/cybex-forge-config.??????) ;;
    *) die "internal config validation path is invalid" ;;
  esac
  if [ ! -f "$config_validation_candidate" ] \
    || [ -L "$config_validation_candidate" ] \
    || [ "$(stat -c '%u:%a:%h' -- "$config_validation_candidate")" != "0:600:1" ]; then
    die "protected config validation candidate was replaced"
  fi
  rm -f -- "$config_validation_candidate"
  sync -f /run
  config_validation_candidate=""
}

validate_initial_config_preflight() {
  [ "$mode" = "install" ] || return 0
  config_validation_candidate="$(mktemp /run/cybex-forge-config.XXXXXX)"
  chmod 0600 "$config_validation_candidate"
  render_initial_config "$config_validation_candidate"
  if ! validate_config_file "$config_validation_candidate" preflight; then
    remove_config_validation_candidate
    die "generated appliance configuration is invalid"
  fi
  remove_config_validation_candidate
}

write_initial_config() {
  local config_path="$TARGET_MOUNT/etc/cybex-forge/config.toml"
  install -d -m 0750 -o root -g "$FORGE_GID" "$TARGET_MOUNT/etc/cybex-forge"
  install -d -m 0700 -o "$FORGE_UID" -g "$FORGE_GID" "$TARGET_MOUNT/var/lib/cybex-forge/bootstrap"
  render_initial_config "$config_path"
  chown root:"$FORGE_GID" "$TARGET_MOUNT/etc/cybex-forge/config.toml"
  chmod 0640 "$TARGET_MOUNT/etc/cybex-forge/config.toml"
}

validate_target_config() {
  local config_path="$TARGET_MOUNT/etc/cybex-forge/config.toml" metadata
  if [ -L "$config_path" ] || [ ! -f "$config_path" ]; then
    die "target appliance configuration is not a protected regular file"
  fi
  metadata="$(stat -c '%u:%a:%h:%s' -- "$config_path")"
  case "$metadata" in
    0:640:1:*) ;;
    *) die "target appliance configuration has unsafe metadata" ;;
  esac
  [ "${metadata##*:}" -le 65536 ] \
    || die "target appliance configuration is unexpectedly large"
  validate_config_file "$config_path" target \
    || die "target appliance configuration is invalid"
}

commit_install_enrollment_code() {
  local target_parent="$TARGET_MOUNT/var/lib/cybex-forge/bootstrap"
  [ "$mode" = "install" ] || return 0
  enrollment_target_path="$target_parent/enrollment-code"
  enrollment_target_staged_path="$target_parent/.enrollment-code.staged"
  enrollment_target_identity=""
  enrollment_target_staged_identity=""
  enrollment_target_cleanup_armed=1
  enrollment_target_committed=0
  for path in "$enrollment_target_path" "$enrollment_target_staged_path"; do
    if [ -e "$path" ] || [ -L "$path" ]; then
      die "refusing residual target enrollment credential state"
    fi
  done

  # All target construction and recovery-state work has completed. Rebind the
  # original source only now. The only persistent copy is first created under
  # a fixed Forge-owned staging name, then atomically renamed to the final
  # path. At no point do two credential files coexist in CYBEX_STATE.
  refresh_enrollment_code_snapshot
  validate_secret_file
  # The input redirection is opened by the root installer before privileges
  # are dropped. noclobber makes staging an O_EXCL creation.
  # shellcheck disable=SC2016
  run_as_target_forge bash -ceu '
    umask 077
    set -o noclobber
    cat > "$1"
    chmod 0600 "$1"
    sync -f "$1"
    sync -f "$(dirname "$1")"
  ' bash "$enrollment_target_staged_path" < "$enrollment_code_file"
  enrollment_target_staged_identity="$(run_as_target_forge cybex-forge-secure-input \
    identity "$enrollment_target_staged_path" 512 secret)"
  discard_enrollment_code_snapshot
  enrollment_stage_checkpoint

  # Linux coreutils implements --no-clobber with renameat2(RENAME_NOREPLACE)
  # when available. Both names share one protected directory/filesystem, so a
  # successful rename atomically publishes the one persistent copy.
  run_as_target_forge mv -T --no-clobber -- \
    "$enrollment_target_staged_path" "$enrollment_target_path"
  if [ -e "$enrollment_target_staged_path" ] \
    || [ -L "$enrollment_target_staged_path" ]; then
    die "target enrollment credential publication was not atomic"
  fi
  run_as_target_forge sync -f "$target_parent"
  enrollment_target_staged_path=""
  enrollment_target_staged_identity=""
  enrollment_target_identity="$(run_as_target_forge \
    cybex-forge-secure-input identity "$enrollment_target_path" 512 secret)"

  # Any failure through this checkpoint is precommit: EXIT erases both exact
  # target copies while deliberately retaining a caller-supplied source so the
  # same authorization can be retried.
  enrollment_commit_checkpoint

  # Commit before consuming a writable source. From here the installed target
  # is authoritative; a source-erasure error must never destroy both copies.
  enrollment_target_committed=1
  enrollment_target_cleanup_armed=0
  if [ "$retain_enrollment_source" -eq 0 ]; then
    cybex-forge-secure-input erase-if-same \
      "$enrollment_code_source" "$enrollment_source_identity"
    enrollment_source_consumed=1
  fi
}

restore_or_backup_config() {
  local config="$TARGET_MOUNT/etc/cybex-forge/config.toml"
  local backup="$TARGET_MOUNT/var/lib/cybex-forge/appliance/config.toml"
  ensure_appliance_metadata_dir
  if [ "$mode" = "install" ]; then
    write_initial_config
    install -m 0600 -o root -g root "$config" "$backup"
    sync -f "$(dirname "$backup")"
  else
    # Repair and recovery both treat CYBEX_STATE as authoritative. The mutable
    # root may be corrupt or attacker-modified and must never replace the
    # protected recovery copy.
    validate_protected_recovery_file "$backup" "appliance recovery config" 65536
    install -d -m 0750 -o root -g "$FORGE_GID" "$(dirname "$config")"
    install -m 0640 -o root -g "$FORGE_GID" "$backup" "$config"
    sync -f "$config"
    sync -f "$(dirname "$config")"
  fi
}

write_runtime_files() {
  local authorized_keys="$TARGET_MOUNT/root/.ssh/authorized_keys"
  local ssh_backup="$TARGET_MOUNT/var/lib/cybex-forge/appliance/root-authorized_keys"
  local ssh_key_temp=""
  install -d -m 0755 "$TARGET_MOUNT/etc/nginx/sites-available" "$TARGET_MOUNT/etc/default"
  cat > "$TARGET_MOUNT/etc/nginx/sites-available/cybex-forge" <<'EOF'
log_format cybex_forge_safe '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';

server {
  listen 80 default_server;
  server_name _;
  root /srv/cybex-forge/www;

  access_log /var/log/nginx/cybex-forge.access.log cybex_forge_safe;
