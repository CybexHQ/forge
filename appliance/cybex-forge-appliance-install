ensure_persistent_host_identity() {
  local metadata_dir="$TARGET_MOUNT/var/lib/cybex-forge/appliance"
  local machine_id_backup="$metadata_dir/machine-id"
  local machine_id_target="$TARGET_MOUNT/etc/machine-id"
  local ssh_dir="$metadata_dir/ssh"
  local ssh_private="$ssh_dir/ssh_host_ed25519_key"
  local ssh_public="$ssh_private.pub"
  local media_sequence="$metadata_dir/media-sequence"
  local machine_id media_sequence_value
  ensure_appliance_metadata_dir

  if [ "$mode" = "install" ]; then
    install -d -m 0755 -o root -g root "$TARGET_MOUNT/etc"
    if [ -L "$machine_id_target" ] \
      || ! machine_id="$(read_exact_single_line "$machine_id_target" 2>/dev/null)" \
      || ! printf '%s' "$machine_id" | LC_ALL=C grep -Eq '^[0-9a-f]{32}$'; then
      rm -f -- "$machine_id_target"
      systemd-machine-id-setup --root="$TARGET_MOUNT" >/dev/null
    fi
    machine_id="$(read_exact_single_line "$machine_id_target")" \
      || die "installed machine-id must be exactly one record"
    printf '%s' "$machine_id" | grep -Eq '^[0-9a-f]{32}$' || die "installed machine-id is invalid"
    [ "$machine_id" != "00000000000000000000000000000000" ] \
      || die "installed machine-id is uninitialized"
    printf '%s\n' "$machine_id" > "$machine_id_backup"
    chown root:root "$machine_id_backup"
    chmod 0600 "$machine_id_backup"
  else
    validate_protected_recovery_file "$machine_id_backup" "appliance machine-id backup" 64
    machine_id="$(read_exact_single_line "$machine_id_backup")" \
      || die "appliance machine-id backup must be exactly one record"
    printf '%s' "$machine_id" | grep -Eq '^[0-9a-f]{32}$' || die "appliance machine-id backup is invalid"
    [ "$machine_id" != "00000000000000000000000000000000" ] \
      || die "appliance machine-id backup is uninitialized"
    rm -f -- "$machine_id_target"
    install -m 0444 -o root -g root "$machine_id_backup" "$machine_id_target"
    validate_protected_recovery_file "$media_sequence" "appliance media sequence" 32
    media_sequence_value="$(read_exact_single_line "$media_sequence")" \
      || die "appliance media sequence must be exactly one record"
    printf '%s' "$media_sequence_value" | LC_ALL=C grep -Eq '^(0|[1-9][0-9]{0,18})$' \
      || die "appliance media sequence is invalid"
  fi

  if [ -L "$ssh_dir" ] || { [ -e "$ssh_dir" ] && [ ! -d "$ssh_dir" ]; }; then
    die "refusing unsafe appliance SSH identity path"
  fi
  if [ -d "$ssh_dir" ]; then
    [ "$(stat -c '%u:%a' -- "$ssh_dir")" = "0:700" ] || die "appliance SSH identity directory must be root-owned mode 0700"
  else
    install -d -m 0700 -o root -g root "$ssh_dir"
  fi
  if [ ! -e "$ssh_private" ] && [ ! -L "$ssh_private" ] && [ ! -e "$ssh_public" ] && [ ! -L "$ssh_public" ]; then
    ssh-keygen -q -t ed25519 -N '' -C cybex-forge-appliance -f "$ssh_private"
    chown root:root "$ssh_private" "$ssh_public"
    chmod 0600 "$ssh_private"
    chmod 0644 "$ssh_public"
  fi
  validate_protected_recovery_file "$ssh_private" "appliance SSH host private key" 4096
  validate_public_recovery_file "$ssh_public" "appliance SSH host public key" 4096
  ssh-keygen -l -f "$ssh_public" >/dev/null 2>&1 || die "appliance SSH host public key is invalid"
  validate_ssh_host_keypair "$ssh_private" "$ssh_public"
  sync -f "$metadata_dir"
}

initialize_media_sequence() {
  [ "$mode" = "install" ] || return 0
  local sequence_path="$TARGET_MOUNT/var/lib/cybex-forge/appliance/media-sequence"
  local temporary
  ensure_appliance_metadata_dir
  if [ -e "$sequence_path" ] || [ -L "$sequence_path" ]; then
    die "fresh appliance media sequence already exists"
  fi
  temporary="$(mktemp "$TARGET_MOUNT/var/lib/cybex-forge/appliance/.media-sequence.XXXXXX")"
  printf '0\n' > "$temporary"
  chown root:root "$temporary"
  chmod 0600 "$temporary"
  sync -f "$temporary"
  mv -- "$temporary" "$sequence_path"
  sync -f "$(dirname "$sequence_path")"
}

advance_media_sequence() {
  local sequence_path="$TARGET_MOUNT/var/lib/cybex-forge/appliance/media-sequence"
  local current next temporary
  validate_protected_recovery_file "$sequence_path" "appliance media sequence" 32
  current="$(<"$sequence_path")"
  printf '%s' "$current" | grep -Eq '^(0|[1-9][0-9]{0,18})$' \
    || die "appliance media sequence is invalid"
  [ "$current" -le 9223372036854775806 ] || die "appliance media sequence is exhausted"
  next=$((current + 1))
  temporary="$(mktemp "$TARGET_MOUNT/var/lib/cybex-forge/appliance/.media-sequence.XXXXXX")"
  printf '%s\n' "$next" > "$temporary"
  chown root:root "$temporary"
  chmod 0600 "$temporary"
  sync -f "$temporary"
  mv -- "$temporary" "$sequence_path"
  sync -f "$(dirname "$sequence_path")"
  printf '%s\n' "$next"
}

remove_exact_update_control_file() {
  local path="$1" parent resolved_parent
  parent="$(dirname "$path")"
  if [ -e "$parent" ] || [ -L "$parent" ]; then
    if [ -L "$parent" ] || [ ! -d "$parent" ]; then
      die "unsafe managed-update control directory: $parent"
    fi
    resolved_parent="$(readlink -f -- "$parent")"
    [ "$resolved_parent" = "$parent" ] || die "managed-update control directory is not canonical: $parent"
  else
    return 0
  fi
  if [ -L "$path" ]; then
    rm -f -- "$path"
  elif [ -e "$path" ]; then
    [ -f "$path" ] || die "refusing non-file managed-update control path: $path"
    rm -f -- "$path"
  fi
  sync -f "$parent"
}

reset_managed_update_control_state() {
  [ "$mode" != "install" ] || return 0
  local resulting_version="$1"
  local updates_dir="$TARGET_MOUNT/var/lib/cybex-forge/updates"
  local releases_dir="$TARGET_MOUNT/opt/cybex-forge/releases"
  local request_path="$updates_dir/request.json"
  local status_path="$updates_dir/status.json"
  local apply_state_path="$releases_dir/apply-state.json"
  local apply_lock_path="$releases_dir/apply.lock"
  local event_id media_sequence created_at event_dir history_dir journal journal_tmp
  local previous_attempt_id="" previous_target_version="" previous_status=""
  local attempt_json=null target_json=null status_json=null source name

  printf '%s' "$resulting_version" | grep -Eq '^[0-9A-Za-z.+-]{1,128}$' || die "embedded Forge version is unsafe"
  journal="$TARGET_MOUNT/var/lib/cybex-forge/appliance/media-rebase-transaction.json"
  if [ -e "$journal" ] || [ -L "$journal" ]; then
    die "a media-rebase transaction is already pending; boot the installed appliance to reconcile it before another repair/recovery"
  fi
  event_id="$(tr 'A-F' 'a-f' < /proc/sys/kernel/random/uuid)"
  printf '%s' "$event_id" | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$' || die "could not generate a media-rebase event ID"
  created_at="$(date -u +'%Y-%m-%dT%H:%M:%S.%NZ')"

  if [ -f "$status_path" ] && [ ! -L "$status_path" ]; then
    previous_attempt_id="$(sed -n 's/^[[:space:]]*"attempt_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$status_path" | head -n 1)"
    previous_target_version="$(sed -n 's/^[[:space:]]*"target_version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$status_path" | head -n 1)"
    previous_status="$(sed -n 's/^[[:space:]]*"status"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$status_path" | head -n 1)"
  elif [ -f "$request_path" ] && [ ! -L "$request_path" ]; then
    previous_target_version="$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$request_path" | head -n 1)"
  fi
  if [ -n "$previous_attempt_id" ]; then
    printf '%s' "$previous_attempt_id" | grep -Eq '^[A-Za-z0-9._-]{1,128}$' || die "stored update attempt ID is unsafe"
    attempt_json="\"$previous_attempt_id\""
  fi
  if [ -n "$previous_target_version" ]; then
    printf '%s' "$previous_target_version" | grep -Eq '^[0-9A-Za-z.+-]{1,128}$' || die "stored update target version is unsafe"
    target_json="\"$previous_target_version\""
  fi
  if [ -n "$previous_status" ]; then
    case "$previous_status" in
      idle|requested|queued|waiting|preflight|downloading|verifying|staged|applying|restarting|health_checking|succeeded|failed|rolled_back|unsupported) ;;
      *) die "stored update status is unknown" ;;
    esac
    status_json="\"$previous_status\""
  fi

  history_dir="$TARGET_MOUNT/var/lib/cybex-forge/appliance/update-history/$event_id"
  install -d -m 0700 -o root -g root "$history_dir"
  for source in "$request_path" "$status_path" "$apply_state_path" "$apply_lock_path"; do
    if [ -f "$source" ] && [ ! -L "$source" ]; then
      name="${source##*/}"
      install -m 0600 -o root -g root "$source" "$history_dir/$name"
    fi
  done
  sync -f "$history_dir"

  media_sequence="$(advance_media_sequence)"
  marker update-state running "mode=$mode action=reset-to-embedded-base event_id=$event_id media_sequence=$media_sequence"

  event_dir="$updates_dir/media-rebase-events"
  if [ -L "$event_dir" ] || { [ -e "$event_dir" ] && [ ! -d "$event_dir" ]; }; then
    die "refusing unsafe media-rebase event queue"
  fi
  if [ -d "$event_dir" ]; then
    [ "$(stat -c '%u:%a' -- "$event_dir")" = "$FORGE_UID:700" ] || die "media-rebase event queue has unsafe ownership or permissions"
  else
    install -d -m 0700 -o "$FORGE_UID" -g "$FORGE_GID" "$event_dir"
  fi
  sync -f "$event_dir"

  # The root-owned journal contains the complete event before any update
  # control file is removed. The boot-time reconciler can therefore
  # replay every interruption point without inventing or losing evidence.
  journal_tmp="$(mktemp "$TARGET_MOUNT/var/lib/cybex-forge/appliance/.media-rebase-transaction.XXXXXX")"
  cat > "$journal_tmp" <<EOF
{"schema":"cybex.forge.media-rebase.v1","event_id":"$event_id","media_sequence":$media_sequence,"mode":"$mode","resulting_version":"$resulting_version","previous_request_attempt_id":$attempt_json,"previous_target_version":$target_json,"previous_status":$status_json,"created_at":"$created_at"}
EOF
  chown root:root "$journal_tmp"
  chmod 0600 "$journal_tmp"
  sync -f "$journal_tmp"
  mv -- "$journal_tmp" "$journal"
  sync -f "$(dirname "$journal")"

  chroot "$TARGET_MOUNT" /usr/local/bin/cybex-forge \
    --config /etc/cybex-forge/config.toml reconcile-appliance
  if [ -e "$journal" ] || [ -L "$journal" ]; then
    die "media-rebase transaction was not finalized"
  fi
  if [ ! -f "$event_dir/$event_id.json" ] || [ -L "$event_dir/$event_id.json" ]; then
    die "media-rebase evidence was not published"
  fi
}

write_install_state() {
  local version="$1"
  local state_dir="$TARGET_MOUNT/var/lib/cybex-forge/appliance"
  local state_path="$state_dir/install-state.json"
  local temporary
  printf '%s' "$version" | grep -Eq '^[0-9A-Za-z.+-]{1,128}$' \
    || die "embedded Forge version is unsafe"
  ensure_appliance_metadata_dir
  if [ -e "$state_path" ] || [ -L "$state_path" ]; then
    if [ -L "$state_path" ] || [ ! -f "$state_path" ]; then
      die "refusing to overwrite unsafe appliance install-state path"
    fi
    validate_protected_recovery_file "$state_path" "appliance install state" 4096
  fi
  temporary="$(mktemp "$state_dir/.install-state.XXXXXX")"
  printf '{"schema":"cybex.forge.appliance.install.v1","version":"%s","mode":"%s","status":"installed"}\n' \
    "$version" "$mode" > "$temporary"
  chown root:root "$temporary"
  chmod 0600 "$temporary"
  sync -f "$temporary"
  if [ -L "$state_path" ] || { [ -e "$state_path" ] && [ ! -f "$state_path" ]; }; then
    rm -f -- "$temporary"
    die "refusing to replace unsafe appliance install-state path"
  fi
  mv -T -- "$temporary" "$state_path"
  sync -f "$state_dir"
}

ensure_target_init() {
  local init_target=/nix/var/nix/profiles/system/init
  local init_link="$TARGET_MOUNT/sbin/init"
  [ -x "$TARGET_MOUNT$init_target" ] \
    || die "installed NixOS system profile has no executable init"
  install -d -m 0755 -o root -g root "$TARGET_MOUNT/sbin"
  if [ -L "$init_link" ]; then
    [ "$(readlink -- "$init_link")" = "$init_target" ] \
      || die "installed NixOS init link is not canonical"
  elif [ -e "$init_link" ]; then
    die "refusing to replace a non-link installed NixOS init path"
  else
    ln -s "$init_target" "$init_link"
  fi
}

install_system() {
  local target_system package_path version
  target_system="$(tr -d '\n' < /etc/cybex-forge-appliance/target-system)"
  package_path="$(tr -d '\n' < /etc/cybex-forge-appliance/package-path)"
  version="$(tr -d '\n' < /etc/cybex-forge-appliance/version)"
  [ -x "$package_path/bin/cybex-forge" ] || die "embedded Forge package is unavailable"
  marker install running "mode=$mode version=$version"
  initialize_media_sequence
  NIXOS_INSTALL_BOOTLOADER=1 nixos-install --root "$TARGET_MOUNT" --system "$target_system" --no-root-passwd
  ensure_target_init
  ensure_persistent_host_identity
  install -d -m 0755 "$TARGET_MOUNT/usr/local/bin"
  install -m 0755 -o root -g root "$package_path/bin/cybex-forge" "$TARGET_MOUNT/usr/local/bin/cybex-forge"
  write_runtime_files
  restore_or_backup_config
  validate_target_config
  write_install_state "$version"
  reset_managed_update_control_state "$version"
  sync
  commit_install_enrollment_code
}

confirm_destructive_install() {
  [ "$mode" = "repair" ] && return 0
  [ "$yes" -eq 1 ] && return 0
  [ -t 0 ] || die "$mode requires --yes in noninteractive mode"
  if [ "$mode" = "install" ]; then
    printf 'This erases all data on %s. Type the full device path to continue: ' "$disk"
  else
    printf 'This reformats EFI/root on %s while preserving CYBEX_STATE and CYBEX_CACHE. Type the full device path to continue: ' "$disk"
  fi
  local confirmation
  IFS= read -r confirmation
  [ "$confirmation" = "$disk" ] || die "installation cancelled"
}

print_target_summary() {
  local ip_address model size
  ip_address="$(detected_ipv4)"
  model="$(lsblk -dn -o MODEL -- "$disk" | sed 's/[[:space:]]*$//')"
  size="$(lsblk -dn -o SIZE -- "$disk" | tr -d '[:space:]')"
  printf 'Detected installer IPv4: %s\n' "${ip_address:-unavailable}"
  printf 'Selected target disk: %s model=%s size=%s\n' "$disk" "${model:-unknown}" "${size:-unknown}"
  marker summary ready "mode=$mode disk=$disk size=${size:-unknown}"
}

main() {
  require_root
  bind_answers_file
  read_answers
  resolve_mode_and_disk
  prompt_install_answers
  bind_enrollment_code_file
  validate_inputs
  if [ "$mode" = "install" ]; then
    # Never carry a readable enrollment descriptor or snapshot through disk
    # inspection, filesystem repair, or nixos-install. Re-snapshot the exact
    # stable source only when the intended credential staging operation runs.
    discard_enrollment_code_snapshot
  fi
  marker preflight running "mode=$mode disk=$disk"
  refuse_committed_appliance_reinstall
  validate_initial_config_preflight
  assert_not_in_use
  print_target_summary
  confirm_destructive_install
  case "$mode" in
    install) partition_new_disk ;;
    repair) wait_for_partitions; verify_layout; verify_appliance_identity; check_filesystems ;;
    recovery) wait_for_partitions; verify_layout; verify_appliance_identity; check_filesystems; prepare_recovery_root ;;
  esac
  mount_target
  install_system
  case "$mode" in
    install) marker complete success "mode=install enrollment=pending-on-first-boot" ;;
    repair|recovery) marker complete success "mode=$mode enrollment=preserved update=media-rebase-pending-ack" ;;
  esac
  completed=1
  cleanup_mounts
  if [ "$poweroff_after" -eq 1 ]; then
    marker poweroff running "reason=unattended-complete"
    systemctl poweroff
  fi
}

main
