#!/usr/bin/env bash
set -Eeuo pipefail

TARGET_MOUNT="/mnt"
MINIMUM_DISK_BYTES=$((128 * 1024 * 1024 * 1024))
FORGE_UID=980
FORGE_GID=980
current_stage="startup"
completed=0
poweroff_after=0
mode=""
disk=""
answers_file=""
enrollment_code_file=""
enrollment_code_source=""
enrollment_source_identity=""
enrollment_source_consumed=0
retain_enrollment_source=0
enrollment_target_path=""
enrollment_target_identity=""
enrollment_target_staged_path=""
enrollment_target_staged_identity=""
enrollment_target_cleanup_armed=0
enrollment_target_committed=0
answers_input_fd=""
secure_input_dir=""
yes=0
cli_mode=""
cli_disk=""
answer_mode=""
answer_disk=""
api_url=""
organization_id=""
public_base_url=""
ssh_authorized_key=""
generated_secret_file=0
config_validation_candidate=""

exec 9>/run/cybex-forge-appliance-install.lock
flock -n 9 || {
  printf 'CYBEX_FORGE_INSTALLER stage=preflight status=failure error=installer-already-running\n' >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  cybex-forge-appliance-install [--mode install|repair|recovery] [--disk /dev/DEVICE]
      [--answers-file ABSOLUTE_PATH] [--enrollment-code-file ABSOLUTE_PATH]
      [--yes] [--poweroff]

Modes:
  install    Destructively partition and install a new appliance.
  repair     Check existing appliance filesystems and reinstall the embedded
             release system closure without formatting data.
  recovery   Reformat only EFI/root and restore the appliance from preserved
             CYBEX_STATE and CYBEX_CACHE partitions.

An unattended answers file uses strict KEY=VALUE records. Supported keys are
MODE, DISK, API_URL, ORGANIZATION_ID, PUBLIC_BASE_URL, and SSH_AUTHORIZED_KEY.
The enrollment code is accepted only through --enrollment-code-file.
EOF
}

marker() {
  local stage="$1"
  local status="$2"
  shift 2
  current_stage="$stage"
  printf 'CYBEX_FORGE_INSTALLER stage=%s status=%s' "$stage" "$status"
  if [ "$#" -gt 0 ]; then printf ' %s' "$*"; fi
  printf '\n'
}

die() {
  printf 'ERROR: %s\n' "$1" >&2
  exit 1
}

cleanup_mounts() {
  local path
  for path in \
    /run/cybex-forge-recovery-state \
    /run/cybex-forge-existing-install \
    /run/cybex-forge-identity-state \
    /run/cybex-forge-identity-root \
    "$TARGET_MOUNT/srv/cybex-forge" \
    "$TARGET_MOUNT/var/lib/cybex-forge" \
    "$TARGET_MOUNT/boot" \
    "$TARGET_MOUNT"; do
    if mountpoint -q "$path"; then umount "$path" || true; fi
  done
}

on_exit() {
  local status="$?"
  local cleanup_failed=0
  trap - EXIT
  if [ "$enrollment_target_cleanup_armed" -eq 1 ] \
    && [ "$enrollment_target_committed" -eq 0 ]; then
    if ! scrub_uncommitted_enrollment_target; then
      printf 'ERROR: failed to scrub an uncommitted target enrollment credential\n' >&2
      cleanup_failed=1
    fi
  fi
  cleanup_mounts
  if [ -n "$config_validation_candidate" ]; then
    case "$config_validation_candidate" in
      /run/cybex-forge-config.??????)
        if [ -f "$config_validation_candidate" ] \
          && [ ! -L "$config_validation_candidate" ] \
          && [ "$(stat -c '%u:%a:%h' -- "$config_validation_candidate" 2>/dev/null || true)" = "0:600:1" ]; then
          rm -f -- "$config_validation_candidate"
          sync -f /run >/dev/null 2>&1 || true
        fi
        ;;
    esac
  fi
  if [ "$generated_secret_file" -eq 1 ] \
    && [ "$enrollment_source_consumed" -eq 0 ] \
    && [ -n "$enrollment_code_source" ] \
    && [ -n "$enrollment_source_identity" ]; then
    cybex-forge-secure-input erase-if-same \
      "$enrollment_code_source" "$enrollment_source_identity" >/dev/null 2>&1 || true
  fi
  if [ -n "$secure_input_dir" ]; then
    case "$secure_input_dir" in
      /run/cybex-forge-input.*)
        if [ -d "$secure_input_dir" ] && [ ! -L "$secure_input_dir" ] \
          && [ "$(stat -c '%u:%a' -- "$secure_input_dir" 2>/dev/null || true)" = "0:700" ]; then
          rm -f -- \
            "$secure_input_dir/answers" \
            "$secure_input_dir/enrollment-code" \
            "$secure_input_dir/enrollment-source"
          rmdir -- "$secure_input_dir" 2>/dev/null || true
        fi
        ;;
    esac
  fi
  if [ "$completed" -eq 0 ]; then
    marker complete failure "mode=${mode:-unknown} failed_stage=$current_stage exit=$status" || true
  fi
  if [ "$cleanup_failed" -eq 1 ] && [ "$status" -eq 0 ]; then
    status=1
  fi
  exit "$status"
}
trap on_exit EXIT

while [ "$#" -gt 0 ]; do
  case "$1" in
    --mode) cli_mode="${2:-}"; shift 2 ;;
    --disk) cli_disk="${2:-}"; shift 2 ;;
    --answers-file) answers_file="${2:-}"; shift 2 ;;
    --enrollment-code-file) enrollment_code_file="${2:-}"; shift 2 ;;
    --retain-enrollment-code-source) retain_enrollment_source=1; shift ;;
    --yes) yes=1; shift ;;
    --poweroff) poweroff_after=1; shift ;;
    -h|--help) usage; completed=1; exit 0 ;;
    *) usage >&2; die "unknown option: $1" ;;
  esac
done

require_root() {
  [ "$(id -u)" -eq 0 ] || die "run the appliance installer as root"
}

validate_absolute_path() {
  local label="$1" value="$2" part old_ifs
  case "$value" in /*) ;; *) die "$label must be an absolute path" ;; esac
  [ "$value" != "/" ] || die "$label must not be /"
  case "$value" in *'//'*) die "$label must be normalized" ;; esac
  old_ifs="$IFS"; IFS='/'
  for part in $value; do
    case "$part" in .|..|*\\*) IFS="$old_ifs"; die "$label must be normalized" ;; esac
  done
  IFS="$old_ifs"
}

validate_plain() {
  local label="$1" value="$2"
  if printf '%s' "$value" | LC_ALL=C grep -q '[[:cntrl:]"\\]'; then
    die "$label contains unsupported characters"
  fi
}

ensure_secure_input_dir() {
  if [ -z "$secure_input_dir" ]; then
    secure_input_dir="$(mktemp -d /run/cybex-forge-input.XXXXXX)"
    chmod 0700 "$secure_input_dir"
  fi
}

bind_answers_file() {
  local snapshot
  [ -n "$answers_file" ] || return 0
  validate_absolute_path "--answers-file" "$answers_file"
  ensure_secure_input_dir
  snapshot="$secure_input_dir/answers"
  cybex-forge-secure-input snapshot "$answers_file" "$snapshot" 16384 public >/dev/null
  exec {answers_input_fd}<"$snapshot"
  rm -f -- "$snapshot"
  answers_file="/proc/self/fd/$answers_input_fd"
}

bind_enrollment_code_file() {
  local snapshot mount_options
  [ -n "$enrollment_code_file" ] || return 0
  validate_absolute_path "--enrollment-code-file" "$enrollment_code_file"
  enrollment_code_source="$enrollment_code_file"
  if [ "$retain_enrollment_source" -eq 1 ]; then
    [ "$enrollment_code_source" = "/run/cybex-forge-seed/enrollment-code" ] \
      || die "--retain-enrollment-code-source is restricted to mounted seed media"
    mount_options="$(findmnt -n -o OPTIONS --target "$enrollment_code_source")"
    case ",$mount_options," in *,ro,*) ;; *) die "retained enrollment source must be on read-only seed media" ;; esac
  fi
  ensure_secure_input_dir
  snapshot="$secure_input_dir/enrollment-code"
  enrollment_source_identity="$(cybex-forge-secure-input snapshot \
    "$enrollment_code_source" "$snapshot" 512 secret)"
  enrollment_code_file="$snapshot"
}

discard_enrollment_code_snapshot() {
  [ -n "$enrollment_code_file" ] || return 0
  if [ -z "$secure_input_dir" ] \
    || [ "$enrollment_code_file" != "$secure_input_dir/enrollment-code" ]; then
    die "protected enrollment snapshot path is inconsistent"
  fi
  if [ -L "$enrollment_code_file" ] || [ ! -f "$enrollment_code_file" ]; then
    die "protected enrollment snapshot was replaced"
  fi
  rm -f -- "$enrollment_code_file"
  sync -f "$secure_input_dir"
  enrollment_code_file=""
}

refresh_enrollment_code_snapshot() {
  local snapshot refreshed_identity
  [ -n "$enrollment_code_source" ] || die "enrollment source is unavailable"
  [ -n "$enrollment_source_identity" ] || die "enrollment source identity is unavailable"
  ensure_secure_input_dir
  snapshot="$secure_input_dir/enrollment-code"
  if [ -e "$snapshot" ] || [ -L "$snapshot" ]; then
    die "protected enrollment snapshot already exists"
  fi
  refreshed_identity="$(cybex-forge-secure-input snapshot \
    "$enrollment_code_source" "$snapshot" 512 secret)"
  if [ "$refreshed_identity" != "$enrollment_source_identity" ]; then
    rm -f -- "$snapshot"
    sync -f "$secure_input_dir"
    die "enrollment source changed after preflight"
  fi
  enrollment_code_file="$snapshot"
}

run_as_target_forge() {
  if [ "$(id -u)" -eq "$FORGE_UID" ] && [ "$(id -g)" -eq "$FORGE_GID" ]; then
    "$@"
  else
    setpriv --reuid="$FORGE_UID" --regid="$FORGE_GID" --clear-groups -- "$@"
  fi
}

enrollment_identity_prefix() {
  local identity="$1"
  printf '%s\n' "${identity%:*:*:*:*}"
}

erase_bound_enrollment_path() {
  local path="$1"
  local identity="$2"
  local owner="$3"
  local rebound=""
  local -a helper=(cybex-forge-secure-input)
  if [ ! -e "$path" ] && [ ! -L "$path" ]; then
    return 0
  fi
  if [ "$owner" = "forge" ]; then
    helper=(run_as_target_forge cybex-forge-secure-input)
  elif [ "$owner" != "root" ]; then
    die "internal enrollment cleanup owner is invalid"
  fi
  if ! printf '%s' "$identity" | grep -Eq '^[0-9]+(:[0-9]+){6}$'; then
    identity="$("${helper[@]}" identity "$path" 512 secret)"
  fi
  if "${helper[@]}" erase-if-same "$path" "$identity" >/dev/null 2>&1; then
    return 0
  fi
  rebound="$("${helper[@]}" identity "$path" 512 secret)" || return 1
  [ "$(enrollment_identity_prefix "$rebound")" = \
    "$(enrollment_identity_prefix "$identity")" ] || return 1
  "${helper[@]}" erase-if-same "$path" "$rebound"
}

scrub_uncommitted_enrollment_target() {
  local failed=0
  [ "$enrollment_target_cleanup_armed" -eq 1 ] || return 0
  if [ -n "$enrollment_target_path" ]; then
    erase_bound_enrollment_path \
      "$enrollment_target_path" "$enrollment_target_identity" forge || failed=1
  fi
  if [ -n "$enrollment_target_staged_path" ]; then
    erase_bound_enrollment_path \
      "$enrollment_target_staged_path" "$enrollment_target_staged_identity" forge || failed=1
  fi
  if [ "$failed" -eq 0 ]; then
    enrollment_target_path=""
    enrollment_target_identity=""
    enrollment_target_staged_path=""
    enrollment_target_staged_identity=""
    enrollment_target_cleanup_armed=0
  fi
  return "$failed"
}

enrollment_commit_checkpoint() {
  # Fault-injection seam. Production deliberately performs no work here.
  :
}

enrollment_stage_checkpoint() {
  # Fault-injection seam before atomic publication.
  :
}

validate_url() {
  local label="$1" value="$2"
  validate_plain "$label" "$value"
  if ! printf '%s' "$value" | LC_ALL=C grep -Eq '^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[^[:space:]"\\?#@]*)?$'; then
    die "$label must be an absolute HTTP(S) URL without query, fragment, or credentials"
  fi
  if printf '%s' "$value" | LC_ALL=C grep -q '[;&|`$<>(){}]'; then
    die "$label contains unsupported characters"
  fi
}

set_answer() {
  local key="$1" value="$2"
  case "$key" in
    MODE) [ -z "$answer_mode" ] || die "answers file repeats MODE"; answer_mode="$value" ;;
    DISK) [ -z "$answer_disk" ] || die "answers file repeats DISK"; answer_disk="$value" ;;
    API_URL) [ -z "$api_url" ] || die "answers file repeats API_URL"; api_url="$value" ;;
    ORGANIZATION_ID) [ -z "$organization_id" ] || die "answers file repeats ORGANIZATION_ID"; organization_id="$value" ;;
    PUBLIC_BASE_URL) [ -z "$public_base_url" ] || die "answers file repeats PUBLIC_BASE_URL"; public_base_url="$value" ;;
    SSH_AUTHORIZED_KEY) [ -z "$ssh_authorized_key" ] || die "answers file repeats SSH_AUTHORIZED_KEY"; ssh_authorized_key="$value" ;;
    *) die "answers file contains unsupported key: $key" ;;
  esac
}

read_answers() {
  local line key value number=0
  [ -n "$answers_file" ] || return 0
  [ -n "$answers_input_fd" ] || die "answers file was not securely bound"
  while IFS= read -r line || [ -n "$line" ]; do
    number=$((number + 1))
    case "$line" in ''|'#'*) continue ;; esac
    case "$line" in *=*) ;; *) die "answers line $number must use KEY=VALUE" ;; esac
    key="${line%%=*}"; value="${line#*=}"
    printf '%s' "$key" | LC_ALL=C grep -Eq '^[A-Z_]+$' || die "answers line $number has an invalid key"
    [ -n "$value" ] || die "answers line $number has an empty value"
    if printf '%s' "$value" | LC_ALL=C grep -q '[[:cntrl:]]'; then die "answers line $number contains control characters"; fi
    set_answer "$key" "$value"
  done < "$answers_file"
}

resolve_mode_and_disk() {
  if [ -n "$cli_mode" ] && [ -n "$answer_mode" ] && [ "$cli_mode" != "$answer_mode" ]; then
    die "--mode conflicts with MODE in the answers file"
  fi
  if [ -n "$cli_disk" ] && [ -n "$answer_disk" ] && [ "$cli_disk" != "$answer_disk" ]; then
    die "--disk conflicts with DISK in the answers file"
  fi
  mode="${cli_mode:-$answer_mode}"
  disk="${cli_disk:-$answer_disk}"
  if [ -z "$mode" ] && [ -t 0 ]; then
    marker guided ready "mode=interactive"
    printf 'Mode (install, repair, recovery): '
    IFS= read -r mode
  fi
  case "$mode" in install|repair|recovery) ;; *) die "mode must be install, repair, or recovery" ;; esac
  if [ -z "$disk" ] && [ -t 0 ]; then
    lsblk -d -o NAME,SIZE,MODEL,TYPE
    printf 'Target disk (for example /dev/sda): '
    IFS= read -r disk
  fi
  validate_absolute_path "target disk" "$disk"
  disk="$(readlink -f -- "$disk")"
  [ -b "$disk" ] || die "target disk is not a block device: $disk"
  [ "$(lsblk -dn -o TYPE -- "$disk")" = "disk" ] || die "target must be a whole disk"
  [ "$(lsblk -dn -o RM -- "$disk")" = "0" ] || die "target disk must be non-removable"
  case "$disk" in /dev/loop*|/dev/ram*|/dev/zram*|/dev/sr*) die "unsupported target disk" ;; esac
  local size
  size="$(blockdev --getsize64 "$disk")"
  [ "$size" -ge "$MINIMUM_DISK_BYTES" ] || die "target disk must be at least 128 GiB"
}

detected_ipv4() {
  ip -4 -o addr show scope global up 2>/dev/null \
    | awk '{ split($4, a, "/"); if (a[1] !~ /^127\./) { print a[1]; exit } }'
}

prompt_install_answers() {
  local detected_ip
  if [ "$mode" != "install" ]; then return 0; fi
  if [ -z "$api_url" ] && [ -t 0 ]; then printf 'Cybex Manage API URL: '; IFS= read -r api_url; fi
  if [ -z "$organization_id" ] && [ -t 0 ]; then printf 'Organization UUID: '; IFS= read -r organization_id; fi
  if [ -z "$public_base_url" ] && [ -t 0 ]; then
    detected_ip="$(detected_ipv4)"
    printf 'Detected installer IPv4: %s\n' "${detected_ip:-unavailable}"
    if [ -n "$detected_ip" ]; then
      printf 'Forge public HTTP URL [http://%s]: ' "$detected_ip"
      IFS= read -r public_base_url
      public_base_url="${public_base_url:-http://$detected_ip}"
    else
      printf 'Forge public HTTP URL: '
      IFS= read -r public_base_url
    fi
  fi
  if [ -z "$ssh_authorized_key" ] && [ -t 0 ]; then
    printf 'Optional root SSH public key (blank to skip): '
    IFS= read -r ssh_authorized_key
  fi
  if [ -z "$enrollment_code_file" ] && [ -t 0 ]; then
    umask 077
    ensure_secure_input_dir
    enrollment_code_file="$secure_input_dir/enrollment-source"
    if [ -e "$enrollment_code_file" ] || [ -L "$enrollment_code_file" ]; then
      die "protected generated enrollment source already exists"
    fi
    generated_secret_file=1
    local code
    IFS= read -r -s -p 'One-time Forge enrollment code: ' code
    printf '\n'
    printf '%s\n' "$code" > "$enrollment_code_file"
    code=""
  fi
}

validate_ssh_key() {
  [ -n "$ssh_authorized_key" ] || return 0
  [ "${#ssh_authorized_key}" -le 8192 ] || die "SSH_AUTHORIZED_KEY is too long"
  case "$ssh_authorized_key" in ssh-ed25519\ *|ecdsa-sha2-nistp256\ *|sk-ssh-ed25519@openssh.com\ *|ssh-rsa\ *) ;; *) die "SSH_AUTHORIZED_KEY uses an unsupported key type" ;; esac
  local temp
  temp="$(mktemp /run/cybex-forge-ssh-key.XXXXXX)"
  chmod 0600 "$temp"
  printf '%s\n' "$ssh_authorized_key" > "$temp"
  ssh-keygen -l -f "$temp" >/dev/null 2>&1 || { rm -f "$temp"; die "SSH_AUTHORIZED_KEY is invalid"; }
  rm -f "$temp"
}

validate_secret_file() {
  local value
  [ -n "$enrollment_code_file" ] || die "install mode requires --enrollment-code-file"
  validate_protected_recovery_file "$enrollment_code_file" "protected enrollment snapshot" 512
  value="$(<"$enrollment_code_file")"
  if [ "${#value}" -lt 16 ] || [ "${#value}" -gt 512 ]; then
    die "enrollment code length is invalid"
  fi
  if printf '%s' "$value" | LC_ALL=C grep -q '[[:space:][:cntrl:]]'; then die "enrollment code contains unsupported characters"; fi
  value=""
}

validate_inputs() {
  validate_ssh_key
  if [ "$mode" = "install" ]; then
    validate_url "API_URL" "$api_url"
    case "$api_url" in
      https://*) ;;
      *) die "API_URL must use HTTPS so the one-time enrollment code is encrypted in transit" ;;
    esac
    validate_url "PUBLIC_BASE_URL" "$public_base_url"
    printf '%s' "$organization_id" | LC_ALL=C grep -Eq '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$' || die "ORGANIZATION_ID must be a UUID"
    validate_secret_file
  elif [ -n "$enrollment_code_file" ]; then
    die "enrollment code input is accepted only in install mode"
  fi
}

partition_path() {
  local number="$1"
  case "$disk" in *[0-9]) printf '%sp%s\n' "$disk" "$number" ;; *) printf '%s%s\n' "$disk" "$number" ;; esac
}

wait_for_partitions() {
  partprobe "$disk"
  udevadm settle
  local number path attempts
  for number in 1 2 3 4; do
    path="$(partition_path "$number")"; attempts=50
    while [ ! -b "$path" ] && [ "$attempts" -gt 0 ]; do sleep 0.1; attempts=$((attempts - 1)); done
    [ -b "$path" ] || die "partition did not appear: $path"
  done
}

assert_not_in_use() {
  local device_name holder source child
  if lsblk -nrpo MOUNTPOINT "$disk" | grep -q '/'; then
    die "target disk has mounted filesystems"
  fi
  while IFS= read -r source; do
    [ -n "$source" ] || continue
    while IFS= read -r child; do
      [ "$source" != "$child" ] || die "target disk contains active swap"
    done < <(lsblk -nrpo NAME "$disk")
  done < <(swapon --show=NAME --noheadings 2>/dev/null || true)
  while IFS= read -r child; do
    device_name="${child##*/}"
    for holder in "/sys/class/block/$device_name/holders"/*; do
      [ ! -e "$holder" ] || die "target disk has active device-mapper or RAID holders"
    done
  done < <(lsblk -nrpo NAME "$disk")
}

partition_new_disk() {
  marker partition running "mode=install disk=$disk"
  assert_not_in_use
  wipefs --all --force "$disk"
  sgdisk --zap-all "$disk"
  sgdisk \
    --new=1:0:+1G --typecode=1:EF00 --change-name=1:CYBEX_EFI \
    --new=2:0:+40G --typecode=2:8300 --change-name=2:CYBEX_ROOT \
    --new=3:0:+16G --typecode=3:8300 --change-name=3:CYBEX_STATE \
    --new=4:0:0 --typecode=4:8300 --change-name=4:CYBEX_CACHE \
    "$disk"
  wait_for_partitions
  mkfs.vfat -F 32 -n CYBEX_EFI "$(partition_path 1)"
  mkfs.ext4 -F -L CYBEX_ROOT "$(partition_path 2)"
  mkfs.ext4 -F -L CYBEX_STATE "$(partition_path 3)"
  mkfs.ext4 -F -L CYBEX_CACHE "$(partition_path 4)"
}

verify_layout() {
  local number expected actual
  for number in 1 2 3 4; do
    case "$number" in 1) expected=CYBEX_EFI ;; 2) expected=CYBEX_ROOT ;; 3) expected=CYBEX_STATE ;; 4) expected=CYBEX_CACHE ;; esac
    if [ "$mode" != "recovery" ] || [ "$number" -ge 3 ]; then
      actual="$(blkid -s LABEL -o value "$(partition_path "$number")" 2>/dev/null || true)"
      [ "$actual" = "$expected" ] || die "partition $number is not labeled $expected"
    fi
  done
}

validate_protected_recovery_file() {
  local path="$1" label="$2" maximum_size="$3" metadata
  if [ -L "$path" ] || [ ! -f "$path" ]; then
    die "$label must be a protected regular file"
  fi
  metadata="$(stat -c '%u:%a:%h:%s' -- "$path")"
  case "$metadata" in
    0:600:1:*) ;;
    *) die "$label has unsafe ownership, permissions, or link count" ;;
  esac
  [ "${metadata##*:}" -le "$maximum_size" ] || die "$label is unexpectedly large"
}

validate_public_recovery_file() {
  local path="$1" label="$2" maximum_size="$3" metadata
  if [ -L "$path" ] || [ ! -f "$path" ]; then
    die "$label must be a regular file"
  fi
  metadata="$(stat -c '%u:%a:%h:%s' -- "$path")"
  case "$metadata" in
    0:644:1:*) ;;
    *) die "$label has unsafe ownership, permissions, or link count" ;;
  esac
  [ "${metadata##*:}" -le "$maximum_size" ] || die "$label is unexpectedly large"
}

read_exact_single_line() {
  local LC_ALL=C
  local path="$1" record byte_count
  [ "$(wc -l < "$path" | tr -d '[:space:]')" = "1" ] || return 1
  [ "$(tail -c 1 -- "$path" | od -An -t u1 | tr -d '[:space:]')" = "10" ] \
    || return 1
  IFS= read -r record < "$path" || return 1
  byte_count="$(wc -c < "$path" | tr -d '[:space:]')"
  [ "$byte_count" -eq "$(( ${#record} + 1 ))" ] || return 1
  printf '%s\n' "$record"
}

read_canonical_install_state_version() {
  local path="$1" record
  record="$(read_exact_single_line "$path")" || return 1
  printf '%s' "$record" | LC_ALL=C grep -Eq \
    '^\{"schema":"cybex\.forge\.appliance\.install\.v1","version":"[0-9A-Za-z.+-]{1,128}","mode":"(install|repair|recovery)","status":"installed"\}$' \
    || return 1
  printf '%s\n' "$record" \
    | sed -n 's/^.*"version":"\([0-9A-Za-z.+-][0-9A-Za-z.+-]*\)".*$/\1/p'
}

validate_ssh_host_keypair() {
  local private_key="$1" public_key="$2" derived_record stored_record
  local derived_public stored_public
  derived_record="$(ssh-keygen -y -P '' -f "$private_key" 2>/dev/null)" \
    || die "appliance SSH host private key is invalid or encrypted"
  stored_record="$(read_exact_single_line "$public_key")" \
    || die "appliance SSH host public key must be exactly one record"
  derived_public="$(printf '%s\n' "$derived_record" \
    | awk 'NF >= 2 { print $1 " " $2; exit }')"
  stored_public="$(printf '%s\n' "$stored_record" \
    | awk 'NF >= 2 { print $1 " " $2; exit }')"
  case "$derived_public" in ssh-ed25519\ *) ;; *) die "appliance SSH host private key is not Ed25519" ;; esac
  case "$stored_public" in ssh-ed25519\ *) ;; *) die "appliance SSH host public key is not Ed25519" ;; esac
  [ "$derived_public" = "$stored_public" ] \
    || die "appliance SSH host keypair does not match"
}

validate_appliance_metadata_dir() {
  local metadata_dir="$1/appliance" metadata machine_id media_sequence authorized_key
  if [ -L "$metadata_dir" ] || [ ! -d "$metadata_dir" ]; then
    die "CYBEX_STATE appliance metadata directory is unsafe"
  fi
  metadata="$(stat -c '%u:%a' -- "$metadata_dir")"
  [ "$metadata" = "0:700" ] || die "CYBEX_STATE appliance metadata directory must be root-owned mode 0700"
  validate_protected_recovery_file "$metadata_dir/install-state.json" "appliance identity record" 4096
  validate_protected_recovery_file "$metadata_dir/config.toml" "appliance recovery config" 65536
  validate_protected_recovery_file "$metadata_dir/machine-id" "appliance machine-id backup" 64
  machine_id="$(read_exact_single_line "$metadata_dir/machine-id")" \
    || die "appliance machine-id backup must be exactly one record"
  printf '%s' "$machine_id" | LC_ALL=C grep -Eq '^[0-9a-f]{32}$' \
    || die "appliance machine-id backup is invalid"
  [ "$machine_id" != "00000000000000000000000000000000" ] \
    || die "appliance machine-id backup is uninitialized"
  validate_protected_recovery_file "$metadata_dir/media-sequence" "appliance media sequence" 32
  media_sequence="$(read_exact_single_line "$metadata_dir/media-sequence")" \
    || die "appliance media sequence must be exactly one record"
  printf '%s' "$media_sequence" | LC_ALL=C grep -Eq '^(0|[1-9][0-9]{0,18})$' \
    || die "appliance media sequence is invalid"
  [ "$media_sequence" -le 9223372036854775807 ] \
    || die "appliance media sequence is exhausted"
  if [ -L "$metadata_dir/ssh" ] || [ ! -d "$metadata_dir/ssh" ]; then
    die "appliance SSH identity directory is unsafe"
  fi
  [ "$(stat -c '%u:%a' -- "$metadata_dir/ssh")" = "0:700" ] || die "appliance SSH identity directory must be root-owned mode 0700"
  validate_protected_recovery_file "$metadata_dir/ssh/ssh_host_ed25519_key" "appliance SSH host private key" 4096
  validate_public_recovery_file "$metadata_dir/ssh/ssh_host_ed25519_key.pub" "appliance SSH host public key" 4096
  ssh-keygen -l -f "$metadata_dir/ssh/ssh_host_ed25519_key.pub" >/dev/null 2>&1 || die "appliance SSH host public key is invalid"
  validate_ssh_host_keypair \
    "$metadata_dir/ssh/ssh_host_ed25519_key" \
    "$metadata_dir/ssh/ssh_host_ed25519_key.pub"
  if [ -e "$metadata_dir/root-authorized_keys" ] || [ -L "$metadata_dir/root-authorized_keys" ]; then
    validate_protected_recovery_file "$metadata_dir/root-authorized_keys" "root SSH authorized-key backup" 8193
    authorized_key="$(read_exact_single_line "$metadata_dir/root-authorized_keys")" \
      || die "root SSH authorized-key backup must be exactly one record"
    case "$authorized_key" in
      ssh-ed25519\ *|ecdsa-sha2-nistp256\ *|sk-ssh-ed25519@openssh.com\ *|ssh-rsa\ *) ;;
      *) die "root SSH authorized-key backup uses an unsupported key type" ;;
    esac
    ssh-keygen -l -f "$metadata_dir/root-authorized_keys" >/dev/null 2>&1 || die "root SSH authorized-key backup is invalid"
  fi
}

validate_media_rebase_queue_room() {
  local event_dir="$1/updates/media-rebase-events"
  local entry name event_id metadata size media_sequence event_count=0
  local -a entries=()
  local -A seen_sequences=()
  [ -e "$event_dir" ] || [ -L "$event_dir" ] || return 0
  if [ -L "$event_dir" ] || [ ! -d "$event_dir" ]; then
    die "media-rebase event queue is unsafe"
  fi
  [ "$(stat -c '%u:%a' -- "$event_dir")" = "$FORGE_UID:700" ] \
    || die "media-rebase event queue has unsafe ownership or permissions"
  mapfile -d '' -n 65 -t entries < <(find -P "$event_dir" -mindepth 1 -maxdepth 1 -print0)
  [ "${#entries[@]}" -le 64 ] \
    || die "media-rebase queue exceeds the 64-entry inspection bound"
  for entry in "${entries[@]}"; do
    name="${entry##*/}"
    case "$name" in
      *.json) event_id="${name%.json}" ;;
      *) die "media-rebase queue contains an incomplete or unknown entry" ;;
    esac
    printf '%s' "$event_id" | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$' \
      || die "media-rebase queue contains an invalid event filename"
    if [ -L "$entry" ] || [ ! -f "$entry" ]; then
      die "media-rebase queue contains a non-regular event"
    fi
    metadata="$(stat -c '%u:%a:%h:%s' -- "$entry")"
    case "$metadata" in "$FORGE_UID":600:1:*) ;; *) die "media-rebase event has unsafe metadata" ;; esac
    size="${metadata##*:}"
    [ "$size" -le 4096 ] || die "media-rebase event exceeds 4 KiB"
    grep -F '"schema":"cybex.forge.media-rebase.v1"' "$entry" >/dev/null \
      || die "media-rebase event schema is invalid"
    grep -F "\"event_id\":\"$event_id\"" "$entry" >/dev/null \
      || die "media-rebase event ID does not match its filename"
    media_sequence="$(sed -n 's/.*"media_sequence":\([0-9][0-9]*\).*/\1/p' "$entry" | head -n 1)"
    printf '%s' "$media_sequence" | grep -Eq '^[1-9][0-9]{0,18}$' \
      || die "media-rebase event sequence is invalid"
    [ "$media_sequence" -le 9223372036854775807 ] \
      || die "media-rebase event sequence is invalid"
    [ -z "${seen_sequences[$media_sequence]+present}" ] \
      || die "media-rebase queue contains a duplicate sequence"
    seen_sequences[$media_sequence]=1
    event_count=$((event_count + 1))
  done
  [ "$event_count" -lt 16 ] \
    || die "media-rebase queue is full; boot normally and let Manage acknowledge pending recovery evidence before using repair/recovery again"
}

ensure_appliance_metadata_dir() {
  local metadata_dir="$TARGET_MOUNT/var/lib/cybex-forge/appliance" metadata
  if [ -L "$metadata_dir" ] || { [ -e "$metadata_dir" ] && [ ! -d "$metadata_dir" ]; }; then
    die "refusing unsafe appliance recovery metadata path"
  fi
  if [ -d "$metadata_dir" ]; then
    metadata="$(stat -c '%u:%a' -- "$metadata_dir")"
    [ "$metadata" = "0:700" ] || die "appliance recovery metadata directory must be root-owned mode 0700"
  else
    install -d -m 0700 -o root -g root "$metadata_dir"
  fi
}

verify_appliance_identity() {
  local state_probe="/run/cybex-forge-identity-state"
  local root_probe="/run/cybex-forge-identity-root"
  local number expected_name actual_name
  for number in 1 2 3 4; do
    case "$number" in 1) expected_name=CYBEX_EFI ;; 2) expected_name=CYBEX_ROOT ;; 3) expected_name=CYBEX_STATE ;; 4) expected_name=CYBEX_CACHE ;; esac
    actual_name="$(lsblk -dn -o PARTLABEL "$(partition_path "$number")")"
    [ "$actual_name" = "$expected_name" ] || die "partition $number has no Cybex appliance GPT identity"
  done
  install -d -m 0700 "$state_probe" "$root_probe"
  # ext4 may replay its journal even for a nominally read-only mount. noload
  # makes this identity/version admission probe genuinely non-writing.
  mount -o ro,noload,nosuid,nodev,noexec "$(partition_path 3)" "$state_probe"
  validate_appliance_metadata_dir "$state_probe" || { umount "$state_probe"; return 1; }
  validate_media_rebase_queue_room "$state_probe" || { umount "$state_probe"; return 1; }
  if [ -e "$state_probe/appliance/media-rebase-transaction.json" ] \
    || [ -L "$state_probe/appliance/media-rebase-transaction.json" ]; then
    validate_protected_recovery_file \
      "$state_probe/appliance/media-rebase-transaction.json" \
      "pending media-rebase transaction" 4096
    umount "$state_probe"
    die "a media-rebase transaction is pending; boot the installed appliance to reconcile it before repair/recovery"
  fi
  local install_state="$state_probe/appliance/install-state.json"
  local installed_version media_version
  validate_protected_recovery_file "$install_state" "appliance install state" 4096
  if ! installed_version="$(read_canonical_install_state_version "$install_state")"; then
    umount "$state_probe"
    die "CYBEX_STATE identity schema is invalid"
  fi
  if ! validate_config_file "$state_probe/appliance/config.toml" identity-admission; then
    umount "$state_probe"
    die "CYBEX_STATE appliance recovery config is invalid"
  fi
  media_version="$(< /etc/cybex-forge-appliance/version)"
  if ! cybex-forge validate-appliance-media \
    --installed-version "$installed_version" --media-version "$media_version"; then
    umount "$state_probe"
    die "replacement media is older than the protected installed appliance state"
  fi
  umount "$state_probe"
  if [ "$mode" = "repair" ]; then
    mount -o ro,noload,nosuid,nodev,noexec "$(partition_path 2)" "$root_probe"
    [ -s "$root_probe/etc/cybex-forge/config.toml" ] || { umount "$root_probe"; die "CYBEX_ROOT is not an installed Forge appliance"; }
    umount "$root_probe"
  fi
}

validate_published_enrollment_code() {
  local path="$1" metadata value
  [ ! -L "$path" ] && [ -f "$path" ] || return 1
  metadata="$(stat -c '%u:%g:%a:%h:%s' -- "$path")"
  case "$metadata" in
    "$FORGE_UID":"$FORGE_GID":600:1:*) ;;
    *) die "committed appliance enrollment credential has unsafe metadata" ;;
  esac
  [ "${metadata##*:}" -le 512 ] \
    || die "committed appliance enrollment credential is unexpectedly large"
  value="$(<"$path")"
  if [ "${#value}" -lt 16 ] || [ "${#value}" -gt 512 ] \
    || printf '%s' "$value" | LC_ALL=C grep -q '[[:space:][:cntrl:]]'; then
    die "committed appliance enrollment credential is invalid"
  fi
}

refuse_committed_appliance_reinstall() {
  local probe="/run/cybex-forge-existing-install"
  local number expected_name actual_name expected_label actual_label
  [ "$mode" = "install" ] || return 0
  for number in 1 2 3 4; do
    [ -b "$(partition_path "$number")" ] || return 0
    case "$number" in
      1) expected_name=CYBEX_EFI; expected_label=CYBEX_EFI ;;
      2) expected_name=CYBEX_ROOT; expected_label=CYBEX_ROOT ;;
      3) expected_name=CYBEX_STATE; expected_label=CYBEX_STATE ;;
      4) expected_name=CYBEX_CACHE; expected_label=CYBEX_CACHE ;;
    esac
    actual_name="$(lsblk -dn -o PARTLABEL "$(partition_path "$number")" 2>/dev/null || true)"
    actual_label="$(blkid -s LABEL -o value "$(partition_path "$number")" 2>/dev/null || true)"
    [ "$actual_name" = "$expected_name" ] \
      && [ "$actual_label" = "$expected_label" ] || return 0
  done

  # A fully published enrollment credential means every earlier install step
  # completed. Refuse to repartition it even if the writable source was
  # already consumed and the prior process died before its success marker.
  verify_appliance_identity
  install -d -m 0700 "$probe"
  mount -o ro,noload,nosuid,nodev,noexec "$(partition_path 3)" "$probe"
  if validate_published_enrollment_code "$probe/bootstrap/enrollment-code"; then
    umount "$probe"
    die "a completed Forge appliance install is already present; boot it to finish enrollment instead of reinstalling"
  fi
  umount "$probe"
}

check_filesystems() {
  marker filesystem-check running "mode=$mode"
  assert_not_in_use
  local first_ext=2
  if [ "$mode" != "recovery" ]; then
    fsck.vfat -a "$(partition_path 1)" || [ "$?" -eq 1 ]
  else
    first_ext=3
  fi
  local number status
  for number in $(seq "$first_ext" 4); do
    status=0
    e2fsck -pf "$(partition_path "$number")" || status="$?"
    [ "$status" -le 1 ] || die "filesystem check failed for partition $number"
  done
}

prepare_recovery_root() {
  marker recovery running "action=preserve-state-cache"
  assert_not_in_use
  install -d -m 0700 /run/cybex-forge-recovery-state
  mount -o ro,noload,nosuid,nodev,noexec "$(partition_path 3)" /run/cybex-forge-recovery-state
  validate_appliance_metadata_dir /run/cybex-forge-recovery-state || {
    umount /run/cybex-forge-recovery-state
    return 1
  }
  if ! validate_config_file \
    /run/cybex-forge-recovery-state/appliance/config.toml recovery-prewipe; then
    umount /run/cybex-forge-recovery-state
    die "CYBEX_STATE appliance recovery config changed or is invalid"
  fi
  umount /run/cybex-forge-recovery-state
  wipefs --all --force "$(partition_path 1)" "$(partition_path 2)"
  mkfs.vfat -F 32 -n CYBEX_EFI "$(partition_path 1)"
  mkfs.ext4 -F -L CYBEX_ROOT "$(partition_path 2)"
}

mount_target() {
  marker mount running "disk=$disk"
  install -d -m 0755 "$TARGET_MOUNT"
  mount "$(partition_path 2)" "$TARGET_MOUNT"
  install -d -m 0700 "$TARGET_MOUNT/boot" "$TARGET_MOUNT/var/lib/cybex-forge" "$TARGET_MOUNT/srv/cybex-forge"
  mount "$(partition_path 1)" "$TARGET_MOUNT/boot"
  mount -o nosuid,nodev "$(partition_path 3)" "$TARGET_MOUNT/var/lib/cybex-forge"
  mount -o nosuid,nodev "$(partition_path 4)" "$TARGET_MOUNT/srv/cybex-forge"
}

