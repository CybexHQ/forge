#!/usr/bin/env bash
set -Eeuo pipefail

MOUNT_ROOT="/mnt/cybex-forge-rescue"
IDENTITY_PROBE="/run/cybex-forge-rescue-identity"
command_name="${1:-}"
disk="${2:-}"
mounted_by_rescue=0
identity_probe_mounted=0

usage() {
  cat <<'EOF'
Usage: cybex-forge-appliance-rescue mount|unmount|check|restore-binary /dev/DEVICE

  mount           Mount root, EFI, state, and cache below /mnt/cybex-forge-rescue.
  unmount         Unmount the rescue tree.
  check           Run read-only filesystem checks (filesystems must be unmounted).
  restore-binary  Run the governed appliance repair flow from the embedded ISO.
EOF
}

die() { printf 'ERROR: %s\n' "$1" >&2; exit 1; }

partition_path() {
  local number="$1"
  case "$disk" in *[0-9]) printf '%sp%s\n' "$disk" "$number" ;; *) printf '%s%s\n' "$disk" "$number" ;; esac
}

validate_disk() {
  case "$disk" in /dev/*) ;; *) die "disk must be an absolute /dev path" ;; esac
  disk="$(readlink -f -- "$disk")"
  if [ ! -b "$disk" ] || [ "$(lsblk -dn -o TYPE "$disk")" != disk ]; then
    die "target must be a whole block disk"
  fi
  [ "$(lsblk -dn -o RM "$disk")" = 0 ] || die "target disk must be non-removable"
  local number expected actual partlabel
  for number in 1 2 3 4; do
    case "$number" in 1) expected=CYBEX_EFI ;; 2) expected=CYBEX_ROOT ;; 3) expected=CYBEX_STATE ;; 4) expected=CYBEX_CACHE ;; esac
    partlabel="$(lsblk -dn -o PARTLABEL "$(partition_path "$number")")"
    [ "$partlabel" = "$expected" ] || die "partition $number has no Cybex GPT identity"
    if [ "$number" -ge 3 ]; then
      actual="$(blkid -s LABEL -o value "$(partition_path "$number")" 2>/dev/null || true)"
      [ "$actual" = "$expected" ] || die "preserved partition $number is not labeled $expected"
    fi
  done
}

unmount_tree() {
  local path
  for path in "$MOUNT_ROOT/srv/cybex-forge" "$MOUNT_ROOT/var/lib/cybex-forge" "$MOUNT_ROOT/boot" "$MOUNT_ROOT"; do
    if mountpoint -q "$path"; then umount "$path"; fi
  done
}

mount_tree() {
  install -d -m 0755 "$MOUNT_ROOT"
  mount "$(partition_path 2)" "$MOUNT_ROOT"
  mounted_by_rescue=1
  install -d -m 0755 "$MOUNT_ROOT/boot" "$MOUNT_ROOT/var/lib/cybex-forge" "$MOUNT_ROOT/srv/cybex-forge"
  mount "$(partition_path 1)" "$MOUNT_ROOT/boot"
  mount -o nosuid,nodev "$(partition_path 3)" "$MOUNT_ROOT/var/lib/cybex-forge"
  mount -o nosuid,nodev "$(partition_path 4)" "$MOUNT_ROOT/srv/cybex-forge"
  printf 'CYBEX_FORGE_RESCUE status=mounted root=%s\n' "$MOUNT_ROOT"
}

validate_protected_identity_file() {
  local path="$1" label="$2" maximum_size="$3" metadata
  if [ -L "$path" ] || [ ! -f "$path" ]; then
    die "$label must be a protected regular file"
  fi
  metadata="$(stat -c '%u:%a:%h:%s' -- "$path")"
  case "$metadata" in
    0:600:1:*) ;;
    *) die "$label has unsafe ownership, permissions, or link count" ;;
  esac
  [ "${metadata##*:}" -le "$maximum_size" ] \
    || die "$label is unexpectedly large"
}

validate_public_identity_file() {
  local path="$1" label="$2" maximum_size="$3" metadata
  if [ -L "$path" ] || [ ! -f "$path" ]; then
    die "$label must be a regular file"
  fi
  metadata="$(stat -c '%u:%a:%h:%s' -- "$path")"
  case "$metadata" in
    0:644:1:*) ;;
    *) die "$label has unsafe ownership, permissions, or link count" ;;
  esac
  [ "${metadata##*:}" -le "$maximum_size" ] \
    || die "$label is unexpectedly large"
}

read_exact_single_line() {
  local LC_ALL=C
  local path="$1" record byte_count
  [ "$(wc -l < "$path" | tr -d '[:space:]')" = "1" ] || return 1
  [ "$(tail -c 1 -- "$path" | od -An -t u1 | tr -d '[:space:]')" = "10" ] \
    || return 1
  IFS= read -r record < "$path" || return 1
  byte_count="$(wc -c < "$path" | tr -d '[:space:]')"
  [ "$byte_count" -eq "$(( ${#record} + 1 ))" ] || return 1
  printf '%s\n' "$record"
}

read_canonical_install_state_version() {
  local path="$1" record
  record="$(read_exact_single_line "$path")" || return 1
  printf '%s' "$record" | LC_ALL=C grep -Eq \
    '^\{"schema":"cybex\.forge\.appliance\.install\.v1","version":"[0-9A-Za-z.+-]{1,128}","mode":"(install|repair|recovery)","status":"installed"\}$' \
    || return 1
  printf '%s\n' "$record" \
    | sed -n 's/^.*"version":"\([0-9A-Za-z.+-][0-9A-Za-z.+-]*\)".*$/\1/p'
}

verify_identity() {
  local probe="$IDENTITY_PROBE"
  local metadata_dir install_state config_backup machine_id media_sequence ssh_dir
  local ssh_private ssh_public authorized_key derived_record stored_record derived_public stored_public
  local installed_version media_version
  install -d -m 0700 "$probe"
  # ext4 read-only mounts can still replay a journal unless noload is set.
  # This admission probe must not alter the appliance before its protected
  # identity and media downgrade boundary have been accepted.
  mount -o ro,noload,nosuid,nodev,noexec "$(partition_path 3)" "$probe"
  identity_probe_mounted=1
  metadata_dir="$probe/appliance"
  if [ -L "$metadata_dir" ] || [ ! -d "$metadata_dir" ] \
    || [ "$(stat -c '%u:%a' -- "$metadata_dir")" != "0:700" ]; then
    die "CYBEX_STATE appliance metadata directory is unsafe"
  fi
  install_state="$metadata_dir/install-state.json"
  config_backup="$metadata_dir/config.toml"
  machine_id="$metadata_dir/machine-id"
  media_sequence="$metadata_dir/media-sequence"
  ssh_dir="$metadata_dir/ssh"
  ssh_private="$ssh_dir/ssh_host_ed25519_key"
  ssh_public="$ssh_private.pub"
  validate_protected_identity_file "$install_state" "appliance install state" 4096
  validate_protected_identity_file "$config_backup" "appliance recovery config" 65536
  validate_protected_identity_file "$machine_id" "appliance machine-id backup" 64
  machine_id="$(read_exact_single_line "$machine_id")" \
    || die "appliance machine-id backup must be exactly one record"
  printf '%s' "$machine_id" | LC_ALL=C grep -Eq '^[0-9a-f]{32}$' \
    || die "appliance machine-id backup is invalid"
  [ "$machine_id" != "00000000000000000000000000000000" ] \
    || die "appliance machine-id backup is uninitialized"
  validate_protected_identity_file "$media_sequence" "appliance media sequence" 32
  media_sequence="$(read_exact_single_line "$media_sequence")" \
    || die "appliance media sequence must be exactly one record"
  printf '%s' "$media_sequence" | LC_ALL=C grep -Eq '^(0|[1-9][0-9]{0,18})$' \
    || die "appliance media sequence is invalid"
  [ "$media_sequence" -le 9223372036854775807 ] \
    || die "appliance media sequence is exhausted"
  if [ -L "$ssh_dir" ] || [ ! -d "$ssh_dir" ] \
    || [ "$(stat -c '%u:%a' -- "$ssh_dir")" != "0:700" ]; then
    die "appliance SSH identity directory is unsafe"
  fi
  validate_protected_identity_file "$ssh_private" "appliance SSH host private key" 4096
  validate_public_identity_file "$ssh_public" "appliance SSH host public key" 4096
  stored_record="$(read_exact_single_line "$ssh_public")" \
    || die "appliance SSH host public key must be exactly one record"
  ssh-keygen -l -f "$ssh_public" >/dev/null 2>&1 \
    || die "appliance SSH host public key is invalid"
  derived_record="$(ssh-keygen -y -P '' -f "$ssh_private" 2>/dev/null)" \
    || die "appliance SSH host private key is invalid or encrypted"
  derived_public="$(printf '%s\n' "$derived_record" | awk 'NF >= 2 { print $1 " " $2; exit }')"
  stored_public="$(printf '%s\n' "$stored_record" | awk 'NF >= 2 { print $1 " " $2; exit }')"
  case "$derived_public" in ssh-ed25519\ *) ;; *) die "appliance SSH host private key is not Ed25519" ;; esac
  case "$stored_public" in ssh-ed25519\ *) ;; *) die "appliance SSH host public key is not Ed25519" ;; esac
  [ "$derived_public" = "$stored_public" ] \
    || die "appliance SSH host keypair does not match"
  if [ -e "$metadata_dir/root-authorized_keys" ] \
    || [ -L "$metadata_dir/root-authorized_keys" ]; then
    validate_protected_identity_file \
      "$metadata_dir/root-authorized_keys" "root SSH authorized-key backup" 8193
    authorized_key="$(read_exact_single_line "$metadata_dir/root-authorized_keys")" \
      || die "root SSH authorized-key backup must be exactly one record"
    case "$authorized_key" in
      ssh-ed25519\ *|ecdsa-sha2-nistp256\ *|sk-ssh-ed25519@openssh.com\ *|ssh-rsa\ *) ;;
      *) die "root SSH authorized-key backup uses an unsupported key type" ;;
    esac
    ssh-keygen -l -f "$metadata_dir/root-authorized_keys" >/dev/null 2>&1 \
      || die "root SSH authorized-key backup is invalid"
  fi
  installed_version="$(read_canonical_install_state_version "$install_state")" \
    || die "CYBEX_STATE appliance identity is missing or invalid"
  cybex-forge --config "$config_backup" validate-appliance-config \
    >/dev/null 2>/dev/null \
    || die "CYBEX_STATE appliance recovery config is invalid"
  media_version="$(< /etc/cybex-forge-appliance/version)"
  if ! cybex-forge validate-appliance-media \
    --installed-version "$installed_version" --media-version "$media_version"; then
    umount "$probe"
    identity_probe_mounted=0
    die "rescue media is older than the protected installed appliance state"
  fi
  umount "$probe"
  identity_probe_mounted=0
}

cleanup() {
  if [ "$identity_probe_mounted" -eq 1 ]; then
    umount "$IDENTITY_PROBE" >/dev/null 2>&1 || true
  fi
  if [ "$mounted_by_rescue" -eq 1 ]; then
    unmount_tree >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

check_tree() {
  lsblk -nrpo MOUNTPOINT "$disk" | grep -q '/' && die "unmount target filesystems before check"
  fsck.vfat -n "$(partition_path 1)"
  local number
  for number in 2 3 4; do e2fsck -fn "$(partition_path "$number")"; done
  printf 'CYBEX_FORGE_RESCUE status=healthy\n'
}

restore_binary() {
  command -v cybex-forge-appliance-install >/dev/null \
    || die "governed appliance repair command is unavailable"
  printf 'CYBEX_FORGE_RESCUE status=delegating-to-governed-repair\n'
  exec cybex-forge-appliance-install --mode repair --disk "$disk" --yes
}

[ "$(id -u)" -eq 0 ] || die "run rescue as root"
case "$command_name" in mount|unmount|check|restore-binary) ;; *) usage >&2; exit 2 ;; esac
validate_disk
if [ "$command_name" != "unmount" ]; then verify_identity; fi
case "$command_name" in
  mount) mount_tree; mounted_by_rescue=0 ;;
  unmount) unmount_tree ;;
  check) check_tree ;;
  restore-binary) restore_binary ;;
esac
