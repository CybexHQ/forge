[Unit]
Description=Cybex Boot managed runtime apply
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/cybex-boot --config /etc/cybex-boot/config.toml apply-runtime-config
WorkingDirectory=/var/lib/cybex-boot
UMask=0077
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_NET_BIND_SERVICE CAP_SETGID CAP_SETUID CAP_SYS_ADMIN
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/cybex-boot /etc/default /etc/nginx /etc/systemd/system /srv/cybex-boot /usr/local/src /var/lib/cybex-boot /run /tmp
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
