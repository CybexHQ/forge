[Unit]
Description=Cybex Forge self-healing availability sentinel
After=cybex-forge.service nginx.service tftpd-hpa.service systemd-resolved.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/cybex-forge-sentinel
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=0
Slice=cybex-forge-control.slice
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID CAP_SYS_NICE
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/cybex-forge
ReadWritePaths=/run /var/lib/cybex-forge
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
UMask=0077
