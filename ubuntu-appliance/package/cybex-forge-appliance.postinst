#!/bin/sh
set -eu

if ! getent group cybex-forge >/dev/null 2>&1; then
  addgroup --system cybex-forge
fi
if ! getent passwd cybex-forge >/dev/null 2>&1; then
  adduser --system --ingroup cybex-forge --home /var/lib/cybex-forge \
    --no-create-home --disabled-login --shell /usr/sbin/nologin cybex-forge
fi
if getent group nix-users >/dev/null 2>&1; then
  adduser cybex-forge nix-users >/dev/null
fi
if ! getent passwd cybex-support >/dev/null 2>&1; then
  adduser --disabled-password --gecos 'Cybex short-lived certificate support' \
    --home /var/lib/cybex-support --shell /bin/bash cybex-support
fi
passwd -l cybex-support >/dev/null 2>&1 || true

install -d -m 0750 -o cybex-forge -g cybex-forge /var/lib/cybex-forge
install -d -m 0700 -o cybex-forge -g cybex-forge /var/lib/cybex-forge/state
install -d -m 0755 -o root -g root /var/cache/cybex-forge
install -d -m 0755 -o root -g root /var/cache/cybex-forge/nix
install -d -m 0750 -o cybex-forge -g cybex-forge /var/cache/cybex-forge/www
install -d -m 0750 -o cybex-forge -g cybex-forge /var/cache/cybex-forge/tftp
install -d -m 0755 /etc/cybex-forge /etc/ssh/sshd_config.d

systemctl mask apt-daily.service apt-daily-upgrade.service \
  apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service >/dev/null 2>&1 || true
systemctl daemon-reload >/dev/null 2>&1 || true
systemctl enable cybex-forge-first-boot.service cybex-forge-firewall.service cybex-forge.service \
  cybex-forge-generation-commit.service cybex-forge-appliance-update.timer \
  cybex-forge-network-change.path nginx tftpd-hpa nix-daemon ssh >/dev/null 2>&1 || true

exit 0
