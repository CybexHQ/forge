#!/bin/sh
set -eu

if ! getent group cybex-pulse >/dev/null 2>&1; then
  addgroup --system cybex-pulse
fi
if ! getent passwd cybex-pulse >/dev/null 2>&1; then
  adduser --system --ingroup cybex-pulse --home /var/lib/cybex-pulse \
    --no-create-home --disabled-login --shell /usr/sbin/nologin cybex-pulse
fi
if getent group nix-users >/dev/null 2>&1; then
  adduser cybex-pulse nix-users >/dev/null
fi
if ! getent passwd cybex-support >/dev/null 2>&1; then
  adduser --disabled-password --gecos 'Cybex short-lived certificate support' \
    --home /var/lib/cybex-support --shell /bin/bash cybex-support
fi
passwd -l cybex-support >/dev/null 2>&1 || true

install -d -m 0750 -o cybex-pulse -g cybex-pulse /var/lib/cybex-pulse
install -d -m 0700 -o cybex-pulse -g cybex-pulse /var/lib/cybex-pulse/state
install -d -m 0755 -o root -g root /var/cache/cybex-pulse
install -d -m 0755 -o root -g root /var/cache/cybex-pulse/nix
install -d -m 0750 -o cybex-pulse -g cybex-pulse /var/cache/cybex-pulse/www
install -d -m 0750 -o cybex-pulse -g cybex-pulse /var/cache/cybex-pulse/tftp
install -d -m 0755 /etc/cybex-pulse /etc/ssh/sshd_config.d

systemctl mask apt-daily.service apt-daily-upgrade.service \
  apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service >/dev/null 2>&1 || true
systemctl daemon-reload >/dev/null 2>&1 || true
systemctl enable cybex-pulse-first-boot.service cybex-pulse-firewall.service cybex-pulse.service \
  cybex-pulse-generation-commit.service cybex-pulse-appliance-update.timer \
  cybex-pulse-network-change.path nginx tftpd-hpa nix-daemon ssh >/dev/null 2>&1 || true

exit 0
