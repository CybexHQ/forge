[Unit]
Description=Apply a signed Cybex Forge Ubuntu root generation
After=network-online.target cybex-forge.service
Wants=network-online.target
ConditionPathExists=/var/lib/cybex-forge/state/appliance-update-request.json

[Service]
Type=oneshot
ExecStart=/usr/lib/cybex-forge/cybex-forge-appliance-update
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=4h
