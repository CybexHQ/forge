[Unit]
Description=Restrict Cybex support SSH to Management-approved CIDRs
Before=ssh.service
After=network-pre.target
ConditionPathExists=/var/lib/cybex-forge/state/management-cidrs.txt

[Service]
Type=oneshot
ExecStart=/usr/lib/cybex-forge/cybex-forge-firewall
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
