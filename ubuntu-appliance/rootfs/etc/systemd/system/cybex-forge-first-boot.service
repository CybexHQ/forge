[Unit]
Description=Verify and activate the managed Cybex Forge appliance
After=local-fs.target systemd-udev-settle.service
Before=network-online.target nix-daemon.service cybex-forge.service
Wants=systemd-udev-settle.service
ConditionPathExists=/var/lib/cybex-forge/state/install-plan.json

[Service]
Type=oneshot
ExecStart=/usr/lib/cybex-forge/cybex-forge-first-boot
RemainAfterExit=yes
TimeoutStartSec=180s

[Install]
WantedBy=multi-user.target
