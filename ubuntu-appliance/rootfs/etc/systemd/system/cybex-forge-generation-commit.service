[Unit]
Description=Commit a healthy Cybex Forge root generation
After=network-online.target cybex-forge.service nginx.service tftpd-hpa.service nix-daemon.service
Wants=network-online.target cybex-forge.service nginx.service tftpd-hpa.service nix-daemon.service
ConditionPathExists=/var/lib/cybex-forge/state/pending-root-generation
ConditionPathExists=/var/lib/cybex-forge/state/appliance-update-request.json

[Service]
Type=oneshot
ExecStart=/usr/lib/cybex-forge/cybex-forge-generation-commit
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
