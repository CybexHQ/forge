[Unit]
Description=Apply a signed two-phase Cybex James Netplan change
After=network-online.target cybex-james.service
Wants=network-online.target cybex-james.service
ConditionPathExists=/var/lib/cybex-james/state/inbox/appliance-network-change-request.json

[Service]
Type=oneshot
ExecStart=/usr/lib/cybex-james/cybex-james-network-change
TimeoutStartSec=5min
