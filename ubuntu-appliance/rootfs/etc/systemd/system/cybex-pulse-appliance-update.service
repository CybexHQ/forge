[Unit]
Description=Apply a signed Cybex Pulse Ubuntu root generation
After=network-online.target cybex-pulse.service
Wants=network-online.target
ConditionPathExists=/var/lib/cybex-pulse/state/appliance-update-request.json

[Service]
Type=oneshot
ExecStart=/usr/lib/cybex-pulse/cybex-pulse-appliance-update
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=4h
