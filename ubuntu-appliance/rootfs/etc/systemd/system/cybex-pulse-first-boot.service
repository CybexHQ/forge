[Unit]
Description=Verify and activate the managed Cybex Pulse appliance
After=local-fs.target systemd-udev-settle.service
Before=network-online.target nix-daemon.service cybex-pulse.service
Wants=systemd-udev-settle.service
ConditionPathExists=/var/lib/cybex-pulse/state/install-plan.json

[Service]
Type=oneshot
ExecStart=/usr/lib/cybex-pulse/cybex-pulse-first-boot
RemainAfterExit=yes
TimeoutStartSec=180s

[Install]
WantedBy=multi-user.target
