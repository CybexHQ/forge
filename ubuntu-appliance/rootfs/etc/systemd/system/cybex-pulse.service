[Unit]
Description=Cybex Pulse managed appliance service
After=network-online.target nix-daemon.service cybex-pulse-first-boot.service
Wants=network-online.target
Requires=cybex-pulse-first-boot.service
RequiresMountsFor=/var/lib/cybex-pulse/state /var/cache/cybex-pulse /nix
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=30s
User=cybex-pulse
Group=cybex-pulse
ExecStart=/usr/bin/cybex-pulse --config /etc/cybex-pulse/config.toml serve
WorkingDirectory=/var/lib/cybex-pulse
Restart=always
RestartSec=3s
UMask=0077
ReadWritePaths=/var/lib/cybex-pulse /var/cache/cybex-pulse
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
