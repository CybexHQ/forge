#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

cidr_file=/var/lib/cybex-forge/state/management-cidrs.txt
rules=/run/cybex-forge-firewall.nft
declare -a ipv4=() ipv6=()
while IFS= read -r cidr; do
  [[ -z "$cidr" ]] && continue
  [[ "$cidr" =~ ^[0-9A-Fa-f:.]+/[0-9]{1,3}$ ]] || {
    echo "error: invalid Management CIDR" >&2
    exit 1
  }
  if [[ "$cidr" == *:* ]]; then ipv6+=("$cidr"); else ipv4+=("$cidr"); fi
done < "$cidr_file"

{
  echo 'table inet cybex_forge {'
  echo ' chain input {'
  echo '  type filter hook input priority -10; policy accept;'
  if ((${#ipv4[@]})); then
    printf '  ip saddr { '
    printf '%s, ' "${ipv4[@]}" | sed 's/, $//'
    echo ' } tcp dport 22 accept'
  fi
  if ((${#ipv6[@]})); then
    printf '  ip6 saddr { '
    printf '%s, ' "${ipv6[@]}" | sed 's/, $//'
    echo ' } tcp dport 22 accept'
  fi
  echo '  tcp dport 22 drop'
  echo ' }'
  echo '}'
} > "$rules"
nft delete table inet cybex_forge 2>/dev/null || true
nft -f "$rules"
