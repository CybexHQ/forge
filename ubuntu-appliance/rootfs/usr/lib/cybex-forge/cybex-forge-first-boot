#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

state_dir=/var/lib/cybex-forge/state
release=/usr/share/cybex-forge/appliance-release.json
test -s "$state_dir/manage-state.json"
test -s "$state_dir/install-plan.json"
test -s "$release"
test "$(jq -er '.base_os' "$state_dir/appliance-release.json")" = ubuntu
test "$(jq -er '.base_os_version' "$state_dir/appliance-release.json")" = 26.04
test "$(jq -er '.at_rest_protection' "$state_dir/appliance-release.json")" = none
test -d /sys/firmware/efi

secure_boot=0
for value in /sys/firmware/efi/efivars/SecureBoot-*; do
  if [[ -f "$value" ]] && [[ "$(od -An -t u1 -j 4 -N 1 "$value" | tr -d ' ')" = 1 ]]; then
    secure_boot=1
  fi
done
test "$secure_boot" -eq 1

root_fsroot="$(findmnt -n -o FSROOT /)"
generations=/.cybex-root-generations
if [[ "$root_fsroot" = / ]]; then
  # Subiquity initially installs into Btrfs' top-level subvolume. Move the
  # running system into generation zero before Forge is allowed to report
  # ready, so every later snapshot is a sibling addressed from subvolid 5.
  mkdir -p "$generations"
  if [[ -e "$generations/0" ]]; then
    btrfs subvolume show "$generations/0" >/dev/null
  else
    btrfs subvolume snapshot / "$generations/0"
  fi
  printf '%s\n' 0 > "$state_dir/root-generation"
  update-grub
  grub-set-default cybex-forge-generation-0
  sync
  systemctl reboot
  exit 0
fi
[[ "$root_fsroot" =~ ^/\.cybex-root-generations/[0-9]+$ ]]

# /nix must be the executable bind mount backed by CYBEX_CACHE. Initialize it
# before nix-daemon or Forge starts, and never delegate store ownership to the
# unprivileged Forge service account.
mountpoint -q /var/cache/cybex-forge
mountpoint -q /nix
test "$(findmnt -n -o UUID /var/cache/cybex-forge)" = "$(findmnt -n -o UUID /nix)"
test "$(findmnt -n -o FSROOT /nix)" = /nix
nix_mount_options=",$(findmnt -n -o OPTIONS /nix),"
[[ "$nix_mount_options" == *,rw,* ]]
[[ "$nix_mount_options" == *,nodev,* ]]
[[ "$nix_mount_options" == *,nosuid,* ]]
[[ "$nix_mount_options" != *,noexec,* ]]
install -d -m 0755 -o root -g root /var/cache/cybex-forge /var/cache/cybex-forge/nix /nix
nix-store --init
test -d /nix/store
test -d /nix/var/nix/db
chown root:root /var/cache/cybex-forge /var/cache/cybex-forge/nix /nix

install -d -m 0750 -o cybex-forge -g cybex-forge \
  /var/cache/cybex-forge/{www/assets,www/cache,tftp,build,build-outputs}
chown -R cybex-forge:cybex-forge \
  /var/lib/cybex-forge/state \
  /var/cache/cybex-forge/{www,tftp,build,build-outputs}
chmod 0600 /var/lib/cybex-forge/state/manage-state.json
chown root:cybex-forge /etc/cybex-forge/config.toml
chmod 0640 /etc/cybex-forge/config.toml

/usr/lib/cybex-forge/cybex-forge-network-guard
ln -sfn /etc/nginx/sites-available/cybex-forge /etc/nginx/sites-enabled/cybex-forge
rm -f /etc/nginx/sites-enabled/default
nginx -t
sshd -t
netplan generate
systemctl enable nix-daemon nginx tftpd-hpa cybex-forge-firewall ssh
systemctl enable cybex-forge.service cybex-forge-appliance-update.timer

generation="$(jq -er '.root_generation' "$state_dir/appliance-release.json")"
delete_root_generation() (
  set -Eeuo pipefail
  local generation_id="$1"
  [[ "$generation_id" =~ ^[0-9]+$ ]]
  local root_uuid root_top candidate
  root_uuid="$(findmnt -n -o UUID /)"
  [[ "$root_uuid" =~ ^[0-9a-fA-F-]{36}$ ]]
  root_top="$(mktemp -d /run/cybex-root-cleanup.XXXXXX)"
  trap 'umount "$root_top" 2>/dev/null || true; rmdir "$root_top" 2>/dev/null || true' EXIT
  mount -t btrfs -o subvolid=5 "UUID=$root_uuid" "$root_top"
  candidate="$root_top/.cybex-root-generations/$generation_id"
  if btrfs subvolume show "$candidate" >/dev/null 2>&1; then
    btrfs subvolume delete "$candidate"
  fi
)
if [[ -s "$state_dir/pending-root-generation" ]]; then
  pending="$(cat "$state_dir/pending-root-generation")"
  [[ "$pending" =~ ^[0-9]+$ ]]
  fsroot="$(findmnt -n -o FSROOT /)"
  if [[ "$fsroot" = "/.cybex-root-generations/$pending" ]]; then
    generation="$pending"
    attempt_id="$(jq -er '.attempt_id' "$state_dir/appliance-update-request.json")"
    target_release="$(jq -er '.release.release_id' "$state_dir/appliance-update-request.json")"
    jq -n --arg generation "$pending" --arg attempt_id "$attempt_id" \
      --arg target_release "$target_release" \
      --arg reported_at "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" \
      '{status:"health_checking",stage:"booted_candidate",attempt_id:$attempt_id,
        target_release:$target_release,progress_percent:90,
        candidate_root_generation:$generation,resulting_root_generation:"",
        rollback_reason:"",reported_at:$reported_at}' \
      > "$state_dir/appliance-update-status.json"
  else
    attempt_id="$(jq -er '.attempt_id' "$state_dir/appliance-update-request.json")"
    target_release="$(jq -er '.release.release_id' "$state_dir/appliance-update-request.json")"
    jq -n --arg generation "$generation" --arg pending "$pending" \
      --arg attempt_id "$attempt_id" --arg target_release "$target_release" \
      --arg reported_at "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" \
      '{status:"rolled_back",stage:"boot_fallback",attempt_id:$attempt_id,
        target_release:$target_release,progress_percent:100,
        candidate_root_generation:$pending,resulting_root_generation:$generation,
        rollback_reason:"candidate_boot_failed",reported_at:$reported_at}' \
      > "$state_dir/appliance-update-status.json"
    delete_root_generation "$pending"
    rm -f "$state_dir/appliance-update-request.json" "$state_dir/pending-root-generation"
  fi
fi
printf '%s\n' "$generation" > "$state_dir/root-generation"
sync -f "$state_dir"
