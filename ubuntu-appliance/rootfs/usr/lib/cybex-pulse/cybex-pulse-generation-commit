#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

state_dir=/var/lib/cybex-pulse/state
pending_file="$state_dir/pending-root-generation"
request="$state_dir/appliance-update-request.json"
status="$state_dir/appliance-update-status.json"
test -s "$pending_file" && test -s "$request"

pending="$(cat "$pending_file")"
attempt_id="$(jq -er '.attempt_id' "$request")"
target_release="$(jq -er '.release.release_id' "$request")"
[[ "$pending" =~ ^[0-9]+$ ]]
test "$(findmnt -n -o FSROOT /)" = "/.cybex-root-generations/$pending"

write_status() {
  local result="$1" stage="$2" reason="${3:-}"
  jq -n --arg status "$result" --arg stage "$stage" --arg attempt_id "$attempt_id" \
    --arg target_release "$target_release" --arg generation "$pending" \
    --arg rollback_reason "$reason" --arg reported_at "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" \
    '{status:$status,stage:$stage,attempt_id:$attempt_id,target_release:$target_release,
      progress_percent:100,candidate_root_generation:$generation,
      resulting_root_generation:(if $status == "succeeded" then $generation else "" end),
      rollback_reason:$rollback_reason,reported_at:$reported_at}' \
    > "$status.tmp"
  chmod 0600 "$status.tmp"
  mv -f "$status.tmp" "$status"
  sync -f "$state_dir"
}

prune_root_generations() (
  set -Eeuo pipefail
  local root_uuid root_top generations generation kept
  root_uuid="$(findmnt -n -o UUID /)"
  [[ "$root_uuid" =~ ^[0-9a-fA-F-]{36}$ ]]
  root_top="$(mktemp -d /run/cybex-root-prune.XXXXXX)"
  trap 'umount "$root_top" 2>/dev/null || true; rmdir "$root_top" 2>/dev/null || true' EXIT
  mount -t btrfs -o subvolid=5 "UUID=$root_uuid" "$root_top"
  generations="$root_top/.cybex-root-generations"
  kept=0
  while IFS= read -r generation; do
    [[ "$generation" =~ ^[0-9]+$ ]]
    if ((generation <= pending && kept < 3)); then
      kept=$((kept + 1))
      continue
    fi
    test "$generation" != "$pending"
    btrfs subvolume delete "$generations/$generation"
  done < <(find "$generations" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | awk '/^[0-9]+$/' | sort -nr)
)

rollback() {
  trap - ERR
  write_status rolled_back health_check_failed local_health_failed
  systemctl reboot
  exit 1
}
trap rollback ERR

for unit in cybex-pulse nginx tftpd-hpa nix-daemon; do
  systemctl is-active --quiet "$unit"
done
curl --fail --silent --show-error --max-time 10 http://127.0.0.1:8080/healthz >/dev/null
test "$(findmnt -n -o FSTYPE /)" = btrfs
test -s /boot/vmlinuz
sbverify --list "$(readlink -f /boot/vmlinuz)" >/dev/null
nix --version >/dev/null

prune_root_generations
grub-set-default "cybex-pulse-generation-$pending"
jq --arg generation "$pending" \
  --arg release_id "$(jq -er '.release_id' /usr/share/cybex-pulse/appliance-release.json)" \
  --arg ubuntu_snapshot_id "$(jq -er '.ubuntu_snapshot_id' /usr/share/cybex-pulse/appliance-release.json)" \
  '.root_generation=$generation | .appliance_release=$release_id |
   .ubuntu_snapshot_id=$ubuntu_snapshot_id' \
  "$state_dir/appliance-release.json" > "$state_dir/appliance-release.json.tmp"
chmod 0600 "$state_dir/appliance-release.json.tmp"
mv -f "$state_dir/appliance-release.json.tmp" "$state_dir/appliance-release.json"
printf '%s\n' "$pending" > "$state_dir/root-generation"
write_status succeeded committed
rm -f "$request" "$pending_file"
sync -f "$state_dir"
trap - ERR
